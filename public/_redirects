# Old HubSpot URLs. Order matters — Netlify stops at the first match.
# The blog now lives at /writing, so legacy /blog links land there rather than
# on the homepage — closer to what the visitor was actually looking for.

/contact             /#notify    301
/blog                /writing/   301
/blog/*              /writing/   301
/starter-package     /           301
/premium-package     /           301
