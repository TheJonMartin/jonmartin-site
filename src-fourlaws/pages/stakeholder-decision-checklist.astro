---
import Base from '../layouts/Base.astro';
import CrossSiteCTA from '../components/CrossSiteCTA.astro';

// Ported from capture/fourlaws/raw-tool-decision-checklist.html.
//
// Scoring logic is unchanged: five items per category, highest count wins, an
// exact tie between two or three categories produces the "mixed signal" verdict.
// The verdict copy is verbatim.
//
// Two deliberate changes from the original:
//   1. The original used inline onclick="resetAll()". Astro bundles this script
//      as a module, so nothing is on `window` — the buttons are wired with
//      addEventListener instead. Same behaviour, no globals.
//   2. The original colour-coded the three categories (cyan / purple / amber).
//      Field & Ledger reserves mustard for a genuine outlier, so all three bars
//      are sage and mustard marks whichever is currently leading — which is the
//      one thing on the page actually worth pointing at.

const sections = [
	{
		key: 'a',
		formula: "Little's Law · L = λW",
		heading: 'The decision queue',
		help: "Signals that you're generating decisions faster than leadership can clear them.",
		items: [
			"More than one decision is currently sitting with the client's leadership, unresolved, right now.",
			'New decisions get raised as they come up, one at a time, rather than being planned for and batched in advance.',
			"You can't say, off the top of your head, how many decisions are currently pending sign-off.",
			'The project plan treats "exec approval" as a single line item rather than a recurring, sized piece of the timeline.',
			'Multiple workstreams have gone quiet in the same week, all waiting on the same person or committee.',
		],
	},
	{
		key: 'b',
		formula: "Kingman's formula · Wait ≈ V·U·T",
		heading: 'Utilization & variability',
		help: 'Signals that the decision-maker is running near capacity, with unpredictable arrivals or wildly uneven decision complexity.',
		items: [
			'The key decision-maker is sponsoring or serving on other initiatives at the same time as yours.',
			'Decisions arrive at unpredictable times — a vendor issue, a budget question, something out of cycle — rather than on a known cadence.',
			"Some decisions take the exec two minutes; others require them to absorb real strategic context — there's no consistency in how much each one costs them.",
			'Wait times for sign-off have been inconsistent — sometimes same-day, sometimes weeks, with no obvious pattern.',
			'You\'ve heard some version of "they\'re just really busy right now" as the explanation for the delay.',
		],
	},
	{
		key: 'c',
		formula: 'Weinberg · Context-switching & distortion',
		heading: 'Signal integrity',
		help: "Signals that the true urgency and cost of delay aren't reaching the person who can actually clear the queue.",
		items: [
			'Someone between you and the final decision-maker is softening or summarizing the ask before it gets to them.',
			'Nobody has put a number — dollars, days, or a missed date — on what the delay is actually costing.',
			'You suspect the real holdup is politics, budget ownership, or someone avoiding blame — not the substance of the decision itself.',
			'More than one person could plausibly be "the one who\'s supposed to decide," and none of them has clearly claimed it.',
			'The project sponsor has an incentive to make things look more on-track than they are when reporting up.',
		],
	},
];

const barLabels = [
	{ key: 'a', text: "Little's Law — queue" },
	{ key: 'b', text: 'Kingman — utilization & variability' },
	{ key: 'c', text: 'Weinberg — signal integrity' },
];
---

<Base
	title="Stakeholder Decision Stall Checklist"
	seoTitle="Stakeholder Decision Stall Checklist | Four Laws"
	description="Check off what's true of a stalled client engagement to see whether you're facing a Little's Law queue problem, a Kingman utilization problem, or a Weinberg signal-distortion problem."
>
	<span class="label eyebrow">Companion tool · Stakeholder decision stalls</span>
	<h1>Stakeholder Decision Stall Checklist</h1>

	<p class="standfirst">
		Check whatever's true of your current engagement. This sorts what you're
		seeing into a Little's Law queue problem, a Kingman utilization/variability
		problem, or a Weinberg information-distortion problem — each one needs a
		different fix. See the reasoning behind each in
		<a href="/stakeholder-decision-bottlenecks">Why Executive Decisions Stall on Client Projects</a>.
	</p>

	{sections.map((section) => (
		<section class:list={['group', section.key]} data-group={section.key}>
			<span class="label formula">{section.formula}</span>
			<h2>{section.heading}</h2>
			<p class="help">{section.help}</p>

			{section.items.map((item) => (
				<label class="citem">
					<input type="checkbox" data-group={section.key} />
					<span>{item}</span>
				</label>
			))}

			<div class="scorebar">
				<div class="track"><div class="fill" id={`fill-${section.key}`}></div></div>
				<span class="count" id={`count-${section.key}`}>0 / 5</span>
			</div>
		</section>
	))}

	<section class="resultwrap">
		<h2>Diagnosis</h2>
		<p class="help">Updates live as you check items above.</p>

		<div class="bars">
			{barLabels.map((bar) => (
				<div class="bar" id={`barwrap-${bar.key}`}>
					<div class="lbl">
						<span>{bar.text}</span>
						<span class="pct" id={`pct-${bar.key}`}>0%</span>
					</div>
					<div class="track"><div class="fill" id={`bar-${bar.key}`}></div></div>
				</div>
			))}
		</div>

		<div class="verdict" id="verdict" aria-live="polite">
			<div class="head">Check a few boxes above to see your diagnosis.</div>
			<div class="t">
				Most stalled engagements are a mix of all three — this just tells you
				which lever to pull first.
			</div>
		</div>

		<div class="btnrow">
			<button type="button" class="secondary" id="reset-btn">↺ Clear all</button>
			<button type="button" id="print-btn">Print / save</button>
		</div>
	</section>

	<p class="note">
		For the reasoning behind each of the three categories above, read
		<a href="/stakeholder-decision-bottlenecks">Why Executive Decisions Stall on Client Projects</a>.
		For the underlying math, see
		<a href="/four-laws-complex-system-design-full#s81">8.1 Little's Law</a> in the
		Full Reference, or plug real numbers into the
		<a href="/flow-formula-calculator">Flow Formula Calculator</a>. If your
		engagement is stuck and you want a second set of eyes on it,
		<a href="/contact">get in touch</a>.
	</p>

	<CrossSiteCTA />
</Base>

<script>
	const verdictCopy: Record<string, { label: string; text: string }> = {
		a: {
			label: "Little's Law — Queue",
			text: "Your strongest signal is a raw <b>decision queue problem</b>: you're pushing decisions up faster than they're being cleared. The fix isn't escalation, it's redesigning the queue — batch decisions into a fixed cadence instead of raising them as they come up, and pre-package each one (options plus a recommendation) so it takes the exec minutes instead of a fresh context-build every time.",
		},
		b: {
			label: 'Kingman — Utilization & Variability',
			text: "Your strongest signal is <b>utilization and variability</b>: the decision-maker is running near capacity across everything they're holding, and both when decisions arrive and how long each one takes are unpredictable. You likely can't get more of their time — but you can lower variability. Standardize how decisions are framed, batch similar ones together, and give advance notice of what's coming so arrivals stop being a surprise.",
		},
		c: {
			label: 'Weinberg — Signal Integrity',
			text: "Your strongest signal is <b>signal integrity</b>: the real cost of delay isn't reaching the person who could clear it, in undistorted form. The fix is making the stakes impossible to soften — attach a dollar-quantified cost-of-delay to every pending decision, name one accountable owner per decision so responsibility can't diffuse, and check whether the real blocker is political rather than substantive.",
		},
		tie: {
			label: 'Mixed signal',
			text: "You're seeing a mix, which is the most common real-world case — all three usually compound each other. Start with whichever category scored highest above; addressing it will often reduce pressure on the other two as well.",
		},
	};

	const groups = ['a', 'b', 'c'] as const;
	const verdictEl = document.getElementById('verdict') as HTMLElement;

	function countFor(g: string) {
		return {
			checked: document.querySelectorAll(`.group.${g} .citem input:checked`).length,
			total: document.querySelectorAll(`.group.${g} .citem input`).length,
		};
	}

	function updateAll() {
		const scores: Record<string, number> = { a: 0, b: 0, c: 0 };

		groups.forEach((g) => {
			const { checked, total } = countFor(g);
			scores[g] = checked;
			const pct = total ? Math.round((checked / total) * 100) : 0;
			(document.getElementById('fill-' + g) as HTMLElement).style.width = pct + '%';
			(document.getElementById('count-' + g) as HTMLElement).textContent = `${checked} / ${total}`;
			(document.getElementById('bar-' + g) as HTMLElement).style.width = pct + '%';
			(document.getElementById('pct-' + g) as HTMLElement).textContent = pct + '%';
		});

		const total = scores.a + scores.b + scores.c;
		groups.forEach((g) =>
			document.getElementById('barwrap-' + g)!.classList.remove('leader')
		);

		if (total === 0) {
			verdictEl.className = 'verdict';
			verdictEl.innerHTML =
				'<div class="head">Check a few boxes above to see your diagnosis.</div>' +
				'<div class="t">Most stalled engagements are a mix of all three — this just tells you which lever to pull first.</div>';
			return;
		}

		const max = Math.max(scores.a, scores.b, scores.c);
		const leaders = groups.filter((k) => scores[k] === max);
		const key = leaders.length > 1 ? 'tie' : leaders[0];
		const info = verdictCopy[key];

		// Mustard marks the leader — but only when there is exactly one. A
		// three-way tie has no outlier to point at.
		if (leaders.length === 1) {
			document.getElementById('barwrap-' + leaders[0])!.classList.add('leader');
		}

		verdictEl.className = 'verdict resolved';
		verdictEl.innerHTML =
			`<div class="head">${info.label}${leaders.length === 1 ? ` (${scores[key]}/5)` : ''}</div>` +
			`<div class="t">${info.text}</div>`;
	}

	document.querySelectorAll<HTMLInputElement>('.citem input').forEach((input) => {
		input.addEventListener('change', () => {
			input.closest('.citem')!.classList.toggle('checked', input.checked);
			updateAll();
		});
	});

	document.getElementById('reset-btn')!.addEventListener('click', () => {
		document.querySelectorAll<HTMLInputElement>('.citem input').forEach((input) => {
			input.checked = false;
			input.closest('.citem')!.classList.remove('checked');
		});
		updateAll();
	});

	document.getElementById('print-btn')!.addEventListener('click', () => window.print());

	updateAll();
</script>

<style>
	.eyebrow { font-size: 0.72rem; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.standfirst { font-size: 1.05rem; color: var(--muted); }

	.group {
		margin: 2.5rem 0;
		padding-top: 1.75rem;
		border-top: 1px solid var(--hairline);
	}
	.formula { font-size: 0.72rem; color: var(--sage); display: block; margin-bottom: 0.3rem; }
	.help { font-size: 0.92rem; color: var(--muted); margin-top: 0.25rem; }

	.citem {
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--hairline);
		font-size: 0.95rem;
		line-height: 1.45;
		cursor: pointer;
	}
	.citem input { margin-top: 0.3rem; accent-color: var(--plum); }
	.citem.checked span { color: var(--plum); }

	.scorebar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.9rem;
	}
	.track {
		flex: 1;
		height: 6px;
		background: rgba(46, 42, 38, 0.1);
		border-radius: 3px;
		overflow: hidden;
	}
	.fill {
		height: 100%;
		width: 0;
		background: var(--sage);
		transition: width 0.18s ease;
	}
	.count, .pct {
		font-family: "Courier New", Courier, monospace;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.resultwrap {
		margin-top: 2.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--hairline);
	}
	.bars { margin: 1.25rem 0; }
	.bar { margin-bottom: 0.9rem; }
	.lbl {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9rem;
		margin-bottom: 0.3rem;
	}
	.bar .track { width: 100%; }
	.bar.leader .fill { background: var(--mustard); }
	.bar.leader .lbl { color: var(--plum); }

	.verdict {
		padding: 1rem 1.1rem;
		background: rgba(124, 148, 115, 0.12);
		border-left: 2px solid var(--sage);
	}
	.verdict.resolved { border-left-color: var(--mustard); }
	.verdict .head {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.05rem;
		color: var(--plum);
		margin-bottom: 0.35rem;
	}
	.verdict .t { font-size: 0.95rem; }

	.btnrow { display: flex; gap: 0.6rem; margin-top: 1.25rem; }
	button {
		font: inherit;
		font-size: 0.95rem;
		color: var(--cream);
		background: var(--plum);
		border: 1px solid var(--plum);
		border-radius: 2px;
		padding: 0.55rem 1.1rem;
		cursor: pointer;
	}
	button.secondary { color: var(--plum); background: transparent; }
	button:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }

	.note { font-size: 0.9rem; color: var(--muted); }

	@media print {
		.btnrow { display: none; }
	}
</style>
