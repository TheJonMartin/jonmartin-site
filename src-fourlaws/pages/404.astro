---
import Base from '../layouts/Base.astro';

// Emitted as /404.html and served by Netlify for any unmatched path. Matters
// more here than on the main site: this config uses build.format 'file', so
// every URL is extensionless and a mistyped or truncated link is a realistic
// way to arrive. Without this page they'd land on Netlify's default, which
// tells them to read Netlify's support documentation.
---

<Base
	title="Page not found"
	seoTitle="Page not found | Four Laws"
	description="That page doesn't exist on the Four Laws reference site. Links to the full reference, the glossary, and the applied examples."
	noindex
>
	<span class="label eyebrow">404</span>
	<h1>That page isn't here.</h1>

	<p class="standfirst">
		The URL structure on this site was frozen during the migration, so old
		links should still work. If one didn't, it's worth telling me about.
	</p>

	<hr class="hairline" />

	<ul class="ways">
		<li>
			<a href="/">Start page</a>
			<span>Everything on this site, grouped by what you want to do with it.</span>
		</li>
		<li>
			<a href="/four-laws-complex-system-design-full">The Full Reference</a>
			<span>Parts 1–8 — the complete document, all four laws and Beer's VSM.</span>
		</li>
		<li>
			<a href="/glossary">Glossary</a>
			<span>Short definitions of every term used here.</span>
		</li>
		<li>
			<a href="/applied-examples">Applied examples</a>
			<span>The laws used on real RevOps, AI-agent, and delivery problems.</span>
		</li>
	</ul>

	<hr class="hairline" />

	<p class="closing">
		Followed a link that should have worked?
		<a href="/contact">Tell me where it came from &rarr;</a>
	</p>
</Base>

<style>
	.eyebrow { font-size: 0.72rem; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.standfirst { font-size: 1.05rem; color: var(--muted); margin: 0.75rem 0 2rem; }

	.ways { list-style: none; padding: 0; margin: 1.5rem 0; }
	.ways li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--hairline);
	}
	.ways li:last-child { border-bottom: none; }
	.ways a { font-size: 1.02rem; text-decoration: none; border-bottom: 1px solid var(--hairline); align-self: flex-start; }
	.ways a:hover { border-bottom-color: var(--plum); }
	.ways span { font-size: 0.95rem; color: var(--muted); }

	.closing { margin-top: 1.5rem; }
</style>
