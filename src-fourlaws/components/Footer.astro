---
// The cross-domain link back to thejonmartin.com also lives in the nav
// (Nav.astro's .crosssite link) so it's reachable from every page, not just
// after scrolling to the bottom. It stays here too, with a name attached
// ("Written by Jon Martin"), as the sign-off a reader sees after finishing
// the material — nav gets you there quickly, footer closes the piece.
const year = new Date().getFullYear();
---

<footer>
	<hr class="hairline" />
	<div class="inner">
		<p class="colophon">
			Four Laws of Complex System Design &copy; {year} Jon Martin. All rights reserved.
		</p>
		<p class="crosslink">
			Written by <a href="https://thejonmartin.com">Jon Martin</a>.
		</p>
	</div>
</footer>

<style>
	.inner {
		max-width: 68rem;
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: space-between;
	}
	p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
	}
</style>
