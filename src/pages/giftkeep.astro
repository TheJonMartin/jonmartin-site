<script>
	const form = document.getElementById('giftkeep-form') as HTMLFormElement | null;
	if (form) {
		const formErr = document.getElementById('sf-form-err');
		const msgs: Record<string, string> = {
			name: 'Please enter your name.',
			email: 'Please enter a valid work email.',
			organization: 'Please enter your organization.',
			role: 'Please choose your role.',
		};

		function check(el: HTMLInputElement | HTMLSelectElement): boolean {
			const err = document.getElementById(el.id + '-err');
			const ok = el.checkValidity();
			el.setAttribute('aria-invalid', ok ? 'false' : 'true');
			if (err) err.textContent = ok ? '' : msgs[el.name] || 'This field is required.';
			return ok;
		}

		const required = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]');
		required.forEach((el) => {
			el.addEventListener('blur', () => {
				if (el.value) check(el);
			});
			el.addEventListener('input', () => {
				if (el.getAttribute('aria-invalid') === 'true') check(el);
			});
		});

		form.addEventListener('submit', (e) => {
			if (formErr) formErr.textContent = '';
			let firstBad: HTMLInputElement | HTMLSelectElement | null = null;
			required.forEach((el) => {
				if (!check(el) && !firstBad) firstBad = el;
			});
			if (firstBad) {
				e.preventDefault();
				firstBad.focus();
			}
		});
	}
</script>
