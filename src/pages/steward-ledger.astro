---
import Base from '../layouts/Base.astro';
import { faqPairsSchema } from '../lib/schema';

const title = 'Steward Ledger';
const seoTitle = 'Steward Ledger: the staff-only gift ledger for nonprofits';
const description =
	"Steward Ledger is a staff-only ledger for donors, sponsors and gifts. Record gifts, run event sponsorships with clear deductible amounts, preview receipts and keep HubSpot up to date.";

// "Common questions" (section 7). One list feeds both the visible FAQ and the
// FAQPage JSON-LD, so the two can't drift apart.
const faqs = [
	{
		q: 'Do our donors need to create an account?',
		a: 'No. Steward Ledger is staff only. Your team signs in; donors never do.',
	},
	{
		q: 'Does Steward replace HubSpot?',
		a: "No. Steward is a gift ledger, not a full CRM. It syncs contacts, companies, deals and products with HubSpot in both directions, so changes made in either place show up in the other.",
	},
	{
		q: 'How is the deductible amount calculated?',
		a: "It's the gift amount minus the good-faith estimate of the benefits the donor received, taken from the benefit lines on the sponsorship package. Your organization sets those estimates. Steward does the math; it doesn't give tax advice.",
	},
	{
		q: 'What if someone enters a gift wrong?',
		a: 'Void it with a reason instead of deleting it. The voided gift and its full change history stay on the record, so anyone can see what happened.',
	},
	{
		q: 'Can we get our data out?',
		a: 'Yes. You can export your records to CSV at any time.',
	},
];
const schema = faqPairsSchema(faqs, 'https://thejonmartin.com/steward-ledger');
---

<Base title={title} seoTitle={seoTitle} description={description} ogImage="/og/steward-ledger.png" schema={schema}>
	<div class="steward">
		<!-- ===== 1. HERO ===== -->
		<section class="st-hero" aria-labelledby="hero-h">
			<div class="st-wrap">
				<div>
					<img class="st-wm-img" src="/steward-ledger/steward-wordmark.svg" alt="Steward Ledger" width="187" height="83" />
					<span class="st-eyebrow">Steward Ledger for nonprofits</span>
					<h1 id="hero-h">One ledger for every gift, sponsor and <span class="st-mark">thank-you</span>.</h1>
					<p class="st-sub">
						Steward Ledger is a staff-only gift ledger for nonprofits. Record gifts, run event sponsorships with
						clear deductible amounts, preview receipts, and keep HubSpot up to date. Donors never need another
						login.
					</p>
					<div class="st-ctas">
						<a class="st-btn st-btn-primary" href="#request">Request information &rarr;</a>
						<a class="st-btn st-btn-ghost" href="#video">Watch the 1-minute tour</a>
					</div>
					<ul class="st-pills" aria-label="At a glance">
						<li>Staff only</li>
						<li>Donors never sign in</li>
						<li>Two-way sync with HubSpot</li>
					</ul>
				</div>
				<div class="st-card" aria-label="Example sponsorship gift (illustration)">
					<div class="st-card-h"><strong>Spring Gala · Gold sponsor</strong><span class="st-tag">Example</span></div>
					<div class="st-row"><span>Gift amount</span><span>$2,500.00</span></div>
					<div class="st-row"><span>Benefits (good-faith estimate)</span><span>&minus; $400.00</span></div>
					<div class="st-row st-total"><span>Deductible amount</span><span>$2,100.00</span></div>
					<p class="st-note">Calculated for you: gift minus the value of the benefits in the package.</p>
					<div class="st-goal">
						<div class="st-goal-top"><span>Fiscal-year goal</span><span>Example progress</span></div>
						<div class="st-bar" role="img" aria-label="Example goal progress bar"><i></i></div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== 2. VIDEO ===== -->
		<section class="st-video" id="video" aria-labelledby="video-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">See it in a minute</span>
				<h2 class="st-h2" id="video-h">A quick tour of Steward Ledger</h2>
				<p class="st-lede">Gifts, sponsorships, goals and the HubSpot sync, start to finish.</p>
				<div class="st-frame">
					<video
						controls
						playsinline
						preload="metadata"
						poster="/steward-ledger/poster.jpg"
						aria-label="Steward Ledger explainer video"
						width="1920"
						height="1080"
					>
						<source src="/steward-ledger/Steward-Ledger-Explainer-1080p-ElevenLabs.mp4" type="video/mp4" />
						Your browser can't play this video.
						<a href="/steward-ledger/Steward-Ledger-Explainer-1080p-ElevenLabs.mp4">Download the explainer (MP4)</a>.
					</video>
				</div>
				<p class="st-cap">About 1 minute · captions shown on screen</p>
			</div>
		</section>

		<!-- ===== 3. PROBLEM / SOLUTION ===== -->
		<section class="st-section st-ps" aria-labelledby="ps-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">Why Steward</span>
				<h2 class="st-h2" id="ps-h">Gift records shouldn't live in five places.</h2>
				<p class="st-lede">
					A spreadsheet here, a payment tool there, sponsor benefits in someone's inbox. Somewhere in between,
					someone forgets to say thank you.
				</p>
			</div>
			<div class="st-wrap">
				<div class="st-ps-grid">
					<div class="st-panel">
						<h3>Without one ledger</h3>
						<ul class="st-list">
							<li>Gifts get typed into spreadsheets, then again into the CRM.</li>
							<li>Sponsor benefits and their value are hard to pin down at receipt time.</li>
							<li>A wrong entry gets deleted, and nobody can say what changed.</li>
							<li>Nobody is quite sure how close you are to this year's goal.</li>
						</ul>
					</div>
					<div class="st-panel st-sol">
						<h3>With Steward Ledger</h3>
						<ul class="st-list">
							<li>Your team records each gift once, in one staff-only ledger.</li>
							<li>Packages carry their benefit lines, so the deductible amount is figured for you.</li>
							<li>Mistakes are voided with a reason, never deleted, and every change is in the history.</li>
							<li>Goal progress sits on the Home screen, and HubSpot gets the updates.</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== 4. FEATURES ===== -->
		<section class="st-section" id="features" aria-labelledby="feat-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">What's inside</span>
				<h2 class="st-h2" id="feat-h">Everything your development team tracks, in one place</h2>
				<p class="st-lede">Built for the people who record, thank and report on gifts.</p>
			</div>
			<div class="st-wrap">
				<div class="st-grid">
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
						</div>
						<h3>Staff only</h3>
						<p>Only your team signs in. Donors never need an account, a password or a portal.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5"/><rect x="14" y="10" width="7.5" height="10" rx="1"/><path d="M16.5 13h2.5M16.5 16h2.5"/></svg>
						</div>
						<h3>Gifts from people and organizations</h3>
						<p>Record gifts from individual donors and from businesses, foundations and other organizations.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
						</div>
						<h3>Events and sponsorship packages</h3>
						<p>Set up events and packages with benefit lines and good-faith estimates of what each benefit is worth.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19L19 5"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/></svg>
						</div>
						<h3>Automatic deductible amount</h3>
						<p>Steward subtracts the value of the benefits from the gift, so the deductible amount is ready when you need it.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h12M12 6l6 6-6 6"/><path d="M20 5v14"/></svg>
						</div>
						<h3>Two-way sync with HubSpot</h3>
						<p>Contacts, companies, deals and products stay in sync between Steward and HubSpot, both directions. Send a HubSpot payment link for any sponsorship package.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4l3 2"/><path d="M3.5 12a8.5 8.5 0 1 0 2.5-6"/><path d="M3 4v4h4"/></svg>
						</div>
						<h3>Void, don't delete</h3>
						<p>Fix a mistake by voiding the gift with a reason. The full change history stays on the record.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
						</div>
						<h3>Fiscal-year and event goals</h3>
						<p>Set goals for the fiscal year and for each event, and see progress on the goal card on Home.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>
						</div>
						<h3>Receipt and year-end previews</h3>
						<p>Preview a gift receipt or a donor's year-end statement before it goes out.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5c1.6.8 2.6 2.6 3 5.5"/></svg>
						</div>
						<h3>Staff roles and login history</h3>
						<p>Give each person an admin or standard role, and see who signed in and when.</p>
					</article>
					<article class="st-feat">
						<div class="st-ico">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v3h16v-3"/></svg>
						</div>
						<h3>CSV export</h3>
						<p>Export your records to CSV for your board, your auditor or your own spreadsheets.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- ===== 5. HOW IT WORKS ===== -->
		<section class="st-section st-steps-sec" aria-labelledby="how-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">How it works</span>
				<h2 class="st-h2" id="how-h">Up and running in three steps</h2>
			</div>
			<div class="st-wrap">
				<ol class="st-steps">
					<li>
						<h3>Set up the year</h3>
						<p>Add your staff, your events and sponsorship packages with their benefit lines, and your fiscal-year and event goals.</p>
					</li>
					<li>
						<h3>Record gifts as they come in</h3>
						<p>Log each gift from a person or organization. Steward figures the deductible amount and keeps the history.</p>
					</li>
					<li>
						<h3>Thank, report and sync</h3>
						<p>Preview receipts and year-end statements, watch the goal card on Home, export to CSV, and let HubSpot pick up the updates.</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- ===== 6. BUILT FOR NONPROFITS ===== -->
		<section class="st-section st-np" aria-labelledby="np-h">
			<div class="st-wrap">
				<div>
					<span class="st-eyebrow">Built for nonprofits</span>
					<h2 class="st-h2" id="np-h">Made for the way development teams actually work</h2>
					<p>
						Executive directors want to see progress toward the goal. Development staff want to record a gift
						once and move on. Treasurers want numbers that hold up and a history that explains every change.
					</p>
					<p>Steward Ledger was built for all three. Our first client is Slingshot ESports.</p>
				</div>
				<div>
					<ul class="st-np-list">
						<li>
							<strong>Receipts that support the quid-pro-quo rules</strong>When a donor gets something back, like
							a gala seat or a sponsor banner, the IRS expects a disclosure of the good-faith value of those
							benefits. Steward's receipts show the gift, the estimated benefits and the deductible amount,
							which helps you meet those disclosure rules.
						</li>
						<li>
							<strong>A record you can stand behind</strong>Voided gifts stay on the books with a reason, and
							every change is logged.
						</li>
						<li>
							<strong>Your CRM stays your CRM</strong>Steward is a gift ledger, not a full CRM. It keeps
							contacts, companies, deals and products in sync with HubSpot, both ways.
						</li>
					</ul>
					<p class="st-fine">
						Steward Ledger is record-keeping software, not tax advice. Your organization decides what values to
						use and how to word its receipts, and your donors should ask their own tax advisor about
						deductions.
					</p>
				</div>
			</div>
		</section>

		<!-- ===== 7. FAQ ===== -->
		<section class="st-section" id="faq" aria-labelledby="faq-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">FAQ</span>
				<h2 class="st-h2" id="faq-h">Common questions</h2>
			</div>
			<div class="st-wrap">
				<div class="st-faq">
					{faqs.map(({ q, a }) => (
						<details>
							<summary>{q}</summary>
							<p>{a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<!-- ===== 7b. PRICING ===== -->
		<section class="st-section st-pricing" id="pricing" aria-labelledby="pricing-h">
			<div class="st-wrap st-center">
				<span class="st-eyebrow">Pricing</span>
				<h2 class="st-h2" id="pricing-h">Simple monthly pricing</h2>
				<div class="st-price-card">
					<div class="st-price-reg">
						<span class="st-price-label">Price</span>
						<span class="st-price-amt">$29/month</span>
						<span class="st-price-fee">Every plan: $199 one-time sign-up fee, includes HubSpot sync setup</span>
						<span class="st-price-terms">No long-term commitment.</span>
					</div>
				</div>
				<div class="st-ctas st-center">
					<a class="st-btn st-btn-primary" href="#request">Request information &rarr;</a>
				</div>
			</div>
		</section>

		<!-- ===== 8. REQUEST INFORMATION FORM ===== -->
		<section class="st-section st-form-sec" id="request" aria-labelledby="form-h">
			<div class="st-wrap">
				<div class="st-form-side">
					<span class="st-eyebrow">Request information</span>
					<h2 class="st-h2" id="form-h">See if Steward Ledger fits your team</h2>
					<p class="st-lede">Tell us a little about your organization. I'll follow up to answer questions or set up a demo.</p>
					<ul class="st-list">
						<li>A walkthrough built around your events and packages</li>
						<li>Straight answers about the HubSpot sync</li>
						<li>No obligation</li>
					</ul>
				</div>

				<div class="st-form">
					<form id="steward-form" name="steward-info" method="POST" action="/thanks-steward" data-netlify="true" netlify-honeypot="bot-field" novalidate>
						<input type="hidden" name="form-name" value="steward-info" />
						<p class="st-hp" aria-hidden="true">
							<label>Leave this empty if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
						</p>

						<div class="st-fields">
							<div class="st-f">
								<label for="sf-name">Name<span class="st-req" aria-hidden="true">*</span></label>
								<input id="sf-name" name="name" type="text" autocomplete="name" required aria-describedby="sf-name-err" />
								<span class="st-err" id="sf-name-err"></span>
							</div>
							<div class="st-f">
								<label for="sf-email">Work email<span class="st-req" aria-hidden="true">*</span></label>
								<input id="sf-email" name="email" type="email" autocomplete="email" required placeholder="you@yourorg.org" aria-describedby="sf-email-err" />
								<span class="st-err" id="sf-email-err"></span>
							</div>
							<div class="st-f">
								<label for="sf-org">Organization<span class="st-req" aria-hidden="true">*</span></label>
								<input id="sf-org" name="organization" type="text" autocomplete="organization" required aria-describedby="sf-org-err" />
								<span class="st-err" id="sf-org-err"></span>
							</div>
							<div class="st-f">
								<label for="sf-role">Your role<span class="st-req" aria-hidden="true">*</span></label>
								<select id="sf-role" name="role" required aria-describedby="sf-role-err">
									<option value="">Choose one</option>
									<option>Executive director</option>
									<option>Development staff</option>
									<option>Treasurer or finance</option>
									<option>Board member</option>
									<option>Other</option>
								</select>
								<span class="st-err" id="sf-role-err"></span>
							</div>
							<div class="st-f st-full">
								<label for="sf-size">Organization size <span class="st-opt">(optional)</span></label>
								<select id="sf-size" name="org_size">
									<option value="">Choose one</option>
									<option>Volunteer-run (no paid staff)</option>
									<option>1 to 5 staff</option>
									<option>6 to 20 staff</option>
									<option>21 to 50 staff</option>
									<option>More than 50 staff</option>
								</select>
							</div>
							<fieldset class="st-f st-full">
								<legend>What do you want help with? <span class="st-opt">(choose any)</span></legend>
								<div class="st-checks">
									<label class="st-check"><input type="checkbox" name="interests" value="Gift tracking" />Gift tracking</label>
									<label class="st-check"><input type="checkbox" name="interests" value="Sponsorships and packages" />Sponsorships and packages</label>
									<label class="st-check"><input type="checkbox" name="interests" value="Receipts and year-end statements" />Receipts and year-end statements</label>
									<label class="st-check"><input type="checkbox" name="interests" value="HubSpot sync" />HubSpot sync</label>
									<label class="st-check"><input type="checkbox" name="interests" value="Goals" />Goals</label>
								</div>
							</fieldset>
							<div class="st-f st-full">
								<label for="sf-msg">Message <span class="st-opt">(optional)</span></label>
								<textarea
									id="sf-msg"
									name="message"
									rows="5"
									placeholder="Anything we should know, like your events, how you track gifts today, or a good time for a demo."
								></textarea>
							</div>
						</div>
						<div class="st-submit">
							<button class="st-btn st-btn-primary" type="submit">Request information &rarr;</button>
							<small>We'll only use this to reply to you.</small>
						</div>
						<p class="st-err" id="sf-form-err" role="alert"></p>
					</form>
				</div>
			</div>
		</section>

		<p class="st-trademark">
			HubSpot is a trademark of HubSpot, Inc. Steward Ledger is not made or endorsed by HubSpot. Not tax advice.
		</p>
	</div>
</Base>

<style is:global>
	@font-face {
		font-family: 'Inter';
		font-weight: 100 900;
		font-display: swap;
		src: url(/fonts/Inter-latin-var.woff) format('woff');
	}

	.steward {
		--primary: #0d7377;
		--primary-dark: #0a5a5c;
		--accent: #d4a017;
		--ink: #1f2937;
		--muted: #4b5563;
		--line: #e5e7eb;
		--tint: #eef7f7;
		--paper: #fbfaf6;

		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		color: var(--ink);
		font-size: 17px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		background: #fff;
	}
	.steward *,
	.steward *::before,
	.steward *::after {
		box-sizing: border-box;
	}
	.steward h1,
	.steward h2,
	.steward h3 {
		font-family: inherit;
		color: var(--ink);
		margin: 0;
		line-height: 1.15;
		letter-spacing: -0.02em;
		font-weight: 800;
	}
	.steward p {
		margin: 0;
	}
	.steward a {
		color: var(--primary);
	}

	.steward .st-wm-img {
		display: block;
		height: 36px;
		width: auto;
		margin-bottom: 18px;
	}

	.steward .st-wrap {
		max-width: 1160px;
		margin: 0 auto;
		padding: 0 28px;
	}
	.steward .st-section {
		padding: 88px 0;
	}
	.steward .st-eyebrow {
		display: inline-block;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: 14px;
	}
	.steward .st-h2 {
		font-size: clamp(28px, 3.4vw, 40px);
		margin-bottom: 16px;
	}
	.steward .st-lede {
		font-size: 19px;
		color: var(--muted);
