---
import FourLawsLayout from '../layouts/FourLawsLayout.astro';

// Hidden form-name must match the form's name; the distinct name keeps these
// submissions separate from the "waitlist" form in the same Netlify project.
---

<FourLawsLayout
	title="Contact"
	seoTitle="Contact Jon Martin | Four Laws of Complex System Design"
	description="Get in touch about the Four Laws framework, a speaking or consulting engagement, or a correction to the site — a short form, no account required."
>
	<span class="label eyebrow">Get in touch</span>
	<h1>Contact</h1>

	<p class="standfirst">
		Questions about the framework, a correction on something in the Full
		Reference, or interested in a consulting or speaking conversation — send a
		note below. I read every message myself; there's no inbox filter and no
		team in between.
	</p>

	<form
		name="fourlaws-contact"
		method="POST"
		action="/thanks-contact"
		data-netlify="true"
		netlify-honeypot="bot-field"
	>
		<input type="hidden" name="form-name" value="fourlaws-contact" />
		<p class="hp">
			<label>Leave this empty if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
		</p>

		<div class="row">
			<label for="name">Name</label>
			<input type="text" id="name" name="name" required autocomplete="name" />
		</div>

		<div class="row">
			<label for="email">Email</label>
			<input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" />
		</div>

		<div class="row">
			<label for="company">Company <span class="opt">(optional)</span></label>
			<input type="text" id="company" name="company" autocomplete="organization" />
		</div>

		<div class="row">
			<label for="message">Message</label>
			<textarea id="message" name="message" rows="6" required></textarea>
		</div>

		<button type="submit">Send message &rarr;</button>
	</form>
</FourLawsLayout>

<style>
	.eyebrow { font-size: 0.72rem; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.standfirst { font-size: 1.05rem; color: var(--muted); margin-bottom: 2.5rem; }
	form { display: flex; flex-direction: column; gap: 1.5rem; }
	.row { display: flex; flex-direction: column; gap: 0.4rem; }
	label { font-size: 0.95rem; font-weight: bold; color: var(--charcoal); }
	.opt { font-weight: normal; opacity: 0.65; }
	input[type='text'],
	input[type='email'],
	textarea {
		width: 100%;
		padding: 0.6rem 0.7rem;
		font: inherit;
		font-size: 1rem;
		color: var(--charcoal);
		background: #fffdf9;
		border: 1px solid rgba(46, 42, 38, 0.3);
		border-radius: 2px;
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--plum);
		outline-offset: 1px;
		border-color: var(--plum);
	}
	textarea { resize: vertical; line-height: 1.5; }
	button {
		align-self: flex-start;
		font: inherit;
		font-size: 1rem;
		color: var(--cream);
		background: var(--plum);
		border: none;
		border-radius: 2px;
		padding: 0.7rem 1.5rem;
		cursor: pointer;
	}
	button:hover { background: #3c2a43; }
	button:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }
	/* Honeypot. Off-screen rather than display:none — some bots skip hidden
	   fields, which defeats the point of having one. */
	.hp { position: absolute; left: -9999px; }
</style>
