---
import Base from '../layouts/Base.astro';
import NotifyForm from '../components/NotifyForm.astro';
import RecentWriting from '../components/RecentWriting.astro';

const title = 'Jon Martin — Field Report & Second Opinion';
const description =
	"I don't build it. I tell you why the last three things you built didn't work — written diagnosis and written second opinions for founders of $3-5M professional services businesses.";
---

<Base title={title} description={description}>
	<main id="main">
		<section class="hero">
			<p class="label kicker">Jon Martin</p>
			<h1>
				You are the only person in your company with enough range to handle what
				comes at it.
			</h1>
			<p class="subhead">
				Every fix you've tried — the hire, the software, the SOP, the management
				layer — has added capacity without adding range. That's why it kept
				breaking anyway.
			</p>
			<hr class="hairline" />
			<p class="tagline">
				I don't build it. I tell you <span class="accent">why</span> the last three
				things you built didn't work.
			</p>
		</section>

		<hr class="hairline" />

		<section class="who">
			<h2>Who this is for</h2>
			<p>
				Founders of professional services businesses doing $3–5M in revenue —
				agencies, consultancies, MSPs, engineering and design firms. Somewhere
				between twenty and fifty people. Still founder-led, still
				founder-dependent: you're still the best seller, often still the best
				deliverer, and still in the loop on everything that matters.
			</p>
			<p>
				You hired someone senior and they can't operate without you. You bought
				software and nobody trusts what it reports. You wrote SOPs and nobody
				follows them. You added a layer of management and it turned into a game
				of telephone. Each of those looks like a separate problem. It isn't.
			</p>
		</section>

		<hr class="hairline" />

		<RecentWriting />

		<hr class="hairline" />

		<NotifyForm />

		<hr class="hairline" />

		<footer>
			<p class="links">
				<a href="/writing/">Writing</a>
				<a href="mailto:jon@thejonmartin.com">jon@thejonmartin.com</a>
			</p>
			<p class="copyright">© 2026 Jon Martin.</p>
		</footer>
	</main>
</Base>

<style>
	/* Top padding was 5rem before the site had a persistent header nav (added
	   alongside src/components/Nav.astro); trimmed to 2.5rem so the hero
	   doesn't sit stacked below both the nav's own padding and this. */
	main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
	.hero { display: flex; flex-direction: column; gap: 1.75rem; padding-top: 0; padding-bottom: 3rem; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); font-weight: 400; }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }
	.tagline { font-size: 1.3rem; font-family: Georgia, serif; color: var(--plum); margin: 0; }
	/* Mustard on cream is 1.92:1 — far below the 4.5:1 minimum, so it can't
	   carry text. The emphasis moves to plum italic (10.33:1, AAA) and mustard
	   becomes a decorative underline, where contrast rules don't apply. Same
	   brand moment, actually readable. */
	.accent {
		color: var(--plum);
		font-style: italic;
		border-bottom: 2px solid var(--mustard);
	}
	section { padding: 3rem 0; }
	h2 { font-size: 1.4rem; margin-bottom: 1.25rem; }
	p { margin: 0 0 1.1rem; }
	p:last-child { margin-bottom: 0; }
	footer { padding: 3rem 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
	.links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
	footer a { font-family: "Courier New", Courier, monospace; text-decoration: none; border-bottom: 1px solid var(--plum); }
	.copyright { font-size: 0.85rem; opacity: 0.6; margin: 0; }
</style>
