---
import Base from '../layouts/Base.astro';
import home from '../content/pages/home.json';
import { getCollection } from 'astro:content';
import { personSchema } from '../lib/schema';

// Copy lives in src/content/pages/home.json so it's editable through the
// Decap CMS at /admin without touching this template. See docs/cms-setup.md.
const { title, description } = home;

const recentPosts = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Portal Audit + Fixer are presented as one product; both buttons go to the app.
// One constant so the destination is a one-line change.
const APP_URL = 'https://audit.thejonmartin.com';

// '#jon' is the site-wide @id for Jon; every BlogPosting author points at it
// rather than re-describing him. The Person itself lives in src/lib/schema.ts.
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		personSchema,
		{
			'@type': 'WebSite',
			'@id': 'https://thejonmartin.com/#website',
			url: 'https://thejonmartin.com/',
			name: 'Jon Martin',
			description,
			publisher: { '@id': 'https://thejonmartin.com/#jon' },
			inLanguage: 'en-US',
		},
	],
};
---

<Base title={title} description={description} schema={schema} navBordered={false}>
	<main id="main">
		<!-- Hero band -->
		<section class="band hero">
			<div class="inner">
				<div class="edge">
					<div class="meta">
						{home.heroMeta.map((cell) => (
							<div class="cell" class:list={{ accent: cell.accent }}>{cell.label}</div>
						))}
					</div>

					<h1 set:html={home.heroTitle.replace(/\bfix it\b/, '<span class="range">fix it</span>')} />

					<div class="herorow">
						<p class="dek">{home.subhead}</p>
						<a class="btn btn-primary" href={APP_URL}>Run my free audit &rarr;</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Offer band -->
		<section class="band offer">
			<div class="inner">
				<p class="label offer-label">The offer</p>
				<p class="offer-statement">{home.offerStatement}</p>
			</div>
		</section>

		<!-- 01 / Who this is for -->
		<section class="band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">01 / {home.whoHeading}</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					{home.whoParagraphs.map((p) => <p class="lede" set:html={p} />)}

					<div class="spectable">
						{home.specTable.map((cell) => (
							<div class="spec">
								<span class="label spec-label">{cell.label}</span>
								<span class="spec-value">{cell.value}</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- 02 / What the audit checks -->
		<section class="band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">02 / {home.checksHeading}</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					{home.checks.map((check, i) => (
						<div class="fixrow">
							<span class="label fix-n">{String(i + 1).padStart(2, '0')}</span>
							<p>{check}</p>
						</div>
					))}
					<div class="convergence">
						<span></span>
						<div class="bracket"></div>
						<p>{home.checksConvergence}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 03 / How Fixer works -->
		<section class="band distinction">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">03 / How fixes work</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					<h2>{home.fixerHeading}</h2>

					<div class="diagram">
						<div class="panel audit">
							<span class="label panel-label">{home.auditLabel}</span>
							<ul class="points">
								{home.auditPoints.map((pt) => <li>{pt}</li>)}
							</ul>
						</div>
						<div class="panel fixer">
							<span class="label panel-label fixer-panel-label">{home.fixerLabel}</span>
							<ul class="points">
								{home.fixerPoints.map((pt) => <li>{pt}</li>)}
							</ul>
						</div>
					</div>
					<p class="label disclaimer">{home.fixerNote}</p>
				</div>
			</div>
		</section>

		<!-- 04 / Start -->
		<section class="band start-band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label start-label">04 / Start</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					<h2 class="start-h">{home.startHeading}</h2>
					<p class="start-body">{home.startBody}</p>
					<div class="start-actions">
						<a class="btn btn-primary" href={APP_URL}>Run my free audit &rarr;</a>
						<a class="start-link" href="/pricing">See plans &rarr;</a>
					</div>
				</div>
			</div>
		</section>
		<!-- 05 / Writing -->
		<section class="band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">05 / {home.writingHeading}</span>
					<div class="rule"></div>
					<a class="label all-writing" href="/writing">All writing &rarr;</a>
				</div>
				<div class="content">
					{recentPosts.map((post, i) => (
						<a class="postrow" href={`/writing/${post.id}`}>
							<span class="label post-n">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<p class="label post-date">{fmt(post.data.pubDate)}</p>
								<h2>{post.data.title}</h2>
								<p class="post-desc">{post.data.description}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

	</main>
</Base>

<style>
	.band { padding: 88px 0; border-top: 1px solid var(--hairline); }
	.band:first-child { border-top: none; }
	.inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }

	/* Ledger grid: a rail (section label) and a content column, used by every
	   section from 01 onward. The hero and offer bands don't use it — they're
	   single-column statements, not rail+content sections. */
	.ledger { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr); gap: 56px; }
	.rail { position: sticky; top: 24px; align-self: start; }
	.section-label { font-size: 12px; color: var(--sage); display: block; margin-bottom: 0.75rem; }
	.rule { width: 40px; height: 2px; background: var(--mustard); }
	.all-writing { display: block; margin-top: 1.25rem; font-size: 12px; color: var(--plum); border-bottom: 1px solid var(--mustard); padding-bottom: 2px; width: fit-content; text-decoration: none; }

	/* ---- Hero ---- */
	.hero { background: var(--plum); color: var(--cream); padding: 72px 0 80px; }
	.hero .edge { border-left: 1px solid var(--hairline-on-plum); padding-left: 18px; }
	.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-bottom: 1px solid var(--hairline-on-plum); margin-bottom: 40px; }
	.cell { padding: 14px 18px; font-family: 'Courier New', Cousine, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--label-on-plum); border-right: 1px solid var(--hairline-on-plum); }
	.cell.accent { color: var(--mustard); }
	.hero h1 { color: var(--cream); font-size: clamp(38px, 6.4vw, 84px); font-weight: 400; line-height: 1.02; letter-spacing: -0.02em; max-width: 16ch; text-wrap: pretty; margin: 0 0 40px; }
	.hero :global(.range) { color: var(--mustard); }
	.herorow { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; align-items: start; }
	.dek { font-size: 19px; line-height: 1.6; color: var(--body-on-plum); margin: 0; }

	.btn { display: inline-block; font-family: 'Courier New', Cousine, monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; padding: 16px 26px; text-decoration: none; justify-self: start; }
	.btn-primary { background: var(--mustard); color: var(--plum); }
	.btn-primary:hover { background: var(--cream); color: var(--plum); }

	/* ---- Offer ---- */
	.offer { background: var(--mustard); padding: 56px 0; border-top: none; }
	.offer-label { font-size: 11px; letter-spacing: 0.18em; color: var(--mustard-shade); margin: 0 0 0.75rem; }
	.offer-statement { font-family: Georgia, Gelasio, serif; font-size: clamp(26px, 4vw, 46px); line-height: 1.14; max-width: 26ch; color: var(--charcoal); margin: 0; }

	/* ---- 01 spec table ---- */
	.lede { font-size: 21px; line-height: 1.55; max-width: 60ch; margin: 0 0 2rem; }
	.spectable { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
	.spec { padding: 18px 0; }
	.spec-label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.spec-value { font-family: Georgia, Gelasio, serif; font-size: 28px; color: var(--plum); }

	/* ---- 02 four fixes ---- */
	.fixrow { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding: 26px 0; border-top: 1px solid var(--hairline); align-items: start; }
	.fixrow:first-child { border-top: none; }
	.fix-n { font-size: 13px; color: var(--sage); padding-top: 6px; }
	.fixrow p { font-family: Georgia, Gelasio, serif; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.3; color: var(--plum); max-width: 44ch; margin: 0; }
	.convergence { display: grid; grid-template-columns: 64px 40px minmax(0, 1fr); border-top: 1px solid var(--hairline); padding-top: 28px; align-items: center; }
	.bracket { border-left: 2px solid var(--mustard); min-height: 60px; }
	.convergence p { padding-left: 22px; font-size: 20px; line-height: 1.5; max-width: 46ch; margin: 0; }

	/* ---- 03 distinction ---- */
	.distinction { background: var(--white); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
	.distinction h2 { font-size: clamp(28px, 3.6vw, 42px); line-height: 1.15; max-width: 26ch; margin: 0 0 2.5rem; }
	.diagram { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; border: 1px solid var(--hairline); }
	.panel { padding: 28px; }
	.panel.fixer { background: var(--cream); }
	.points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
	.points li { font-size: 18px; line-height: 1.5; padding-left: 18px; border-left: 2px solid var(--sage); }
	.panel.fixer .points li { border-left-color: var(--mustard); }
	.panel-label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 1rem; }
	.fixer-panel-label { color: var(--dark-mustard); }
	.disclaimer { font-size: 12px; color: var(--muted); margin: 1.25rem 0 0; }

	/* ---- 04 writing ---- */
	.postrow { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding: 28px 0; border-top: 1px solid var(--hairline); text-decoration: none; color: inherit; }
	.postrow:first-child { border-top: none; }
	.postrow:hover { background: var(--white); }
	.post-n { font-size: 12px; color: var(--sage); }
	.post-date { font-size: 11px; color: var(--muted); margin: 0 0 0.35rem; }
	.postrow h2 { font-family: Georgia, Gelasio, serif; font-size: clamp(21px, 2.4vw, 30px); line-height: 1.22; color: var(--plum); max-width: 36ch; margin: 0 0 0.4rem; }
	.post-desc { font-size: 17px; line-height: 1.55; max-width: 62ch; margin: 0; color: var(--charcoal); }

	/* ---- 05 start ---- */
	.start-band { background: var(--plum); color: var(--cream); }
	.start-band .rule { background: var(--mustard); }
	.start-label { color: var(--mustard); }
	.start-h { color: var(--cream); font-size: clamp(30px, 4vw, 48px); line-height: 1.1; margin: 0 0 1rem; }
	.start-body { font-size: 20px; line-height: 1.55; color: var(--body-on-plum); max-width: 52ch; margin: 0 0 2rem; }
	.start-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; }
	.start-link { font-family: 'Courier New', Cousine, monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--cream); border-bottom: 1px solid var(--mustard); padding-bottom: 2px; text-decoration: none; }

	@media (max-width: 720px) {
		.inner { padding: 0 20px; }
		.band { padding: 56px 0; }
		.ledger { grid-template-columns: 1fr; gap: 28px; }
		.rail { position: static; }
	}
</style>
