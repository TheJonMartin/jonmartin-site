---
import Base from '../layouts/Base.astro';
import NotifyForm from '../components/NotifyForm.astro';
import RecentWriting from '../components/RecentWriting.astro';
import home from '../content/pages/home.json';

// Copy lives in src/content/pages/home.json so it's editable through the
// Decap CMS at /admin without touching this template. See docs/cms-setup.md.
const { title, description } = home;

// Person + WebSite, emitted as a @graph so both entities share one script block
// and can reference each other by @id.
//
// The '#jon' @id is the stable identifier for Jon-the-entity across the whole
// site — every BlogPosting's author field points at this same @id rather than
// re-describing him, which is what lets a crawler understand the posts and the
// person as one thing rather than several.
//
// `knowsAbout` and `sameAs` are the two fields that do real work here: the first
// is the topical claim, the second is how an engine reconciles this Person with
// the same person elsewhere on the web. Add profile URLs to sameAs as they
// become worth claiming.
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://thejonmartin.com/#jon',
			name: 'Jon Martin',
			url: 'https://thejonmartin.com/',
			email: 'mailto:jon@thejonmartin.com',
			jobTitle: 'Revenue Operations Solutions Architect',
			description:
				'Writes diagnoses of why systems, processes, and org structures keep breaking in founder-led professional services firms.',
			knowsAbout: [
				'Revenue Operations',
				'Organizational Design',
				'Systems Thinking',
				'Subscription Management',
				'Systems Integration',
				"Conway's Law",
				"Ashby's Law of Requisite Variety",
			],
			sameAs: ['https://fourlaws.thejonmartin.com/'],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://thejonmartin.com/#website',
			url: 'https://thejonmartin.com/',
			name: 'Jon Martin',
			description,
			publisher: { '@id': 'https://thejonmartin.com/#jon' },
			inLanguage: 'en-US',
		},
	],
};
---

<Base title={title} description={description} schema={schema}>
	<main id="main">
		<section class="hero">
			<p class="label kicker">{home.kicker}</p>
			<h1>{home.heroTitle}</h1>
			<p class="subhead">{home.subhead}</p>
			<hr class="hairline" />
			<p class="tagline" set:html={home.tagline} />
		</section>

		<hr class="hairline" />

		<section class="who">
			<h2>{home.whoHeading}</h2>
			{home.whoParagraphs.map((paragraph) => <p set:html={paragraph} />)}
		</section>

		<hr class="hairline" />

		<RecentWriting />

		<hr class="hairline" />

		<NotifyForm />

		<hr class="hairline" />

		<footer>
			<p class="links">
				<a href="/writing/">Writing</a>
				<a href="mailto:jon@thejonmartin.com">jon@thejonmartin.com</a>
			</p>
			<p class="copyright">© {home.copyrightYear} Jon Martin.</p>
		</footer>
	</main>
</Base>

<style>
	/* Top padding was 5rem before the site had a persistent header nav (added
	   alongside src/components/Nav.astro); trimmed to 2.5rem so the hero
	   doesn't sit stacked below both the nav's own padding and this. */
	main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
	.hero { display: flex; flex-direction: column; gap: 1.75rem; padding-top: 0; padding-bottom: 3rem; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); font-weight: 400; }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }
	.tagline { font-size: 1.3rem; font-family: Georgia, serif; color: var(--plum); margin: 0; }
	/* Mustard on cream is 1.92:1 — far below the 4.5:1 minimum, so it can't
	   carry text. The emphasis moves to plum italic (10.33:1, AAA) and mustard
	   becomes a decorative underline, where contrast rules don't apply. Same
	   brand moment, actually readable. */
	.accent {
		color: var(--plum);
		font-style: italic;
		border-bottom: 2px solid var(--mustard);
	}
	section { padding: 3rem 0; }
	h2 { font-size: 1.4rem; margin-bottom: 1.25rem; }
	p { margin: 0 0 1.1rem; }
	p:last-child { margin-bottom: 0; }
	footer { padding: 3rem 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
	.links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
	footer a { font-family: "Courier New", Courier, monospace; text-decoration: none; border-bottom: 1px solid var(--plum); }
	.copyright { font-size: 0.85rem; opacity: 0.6; margin: 0; }
</style>
