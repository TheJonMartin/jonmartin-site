---
import Base from '../layouts/Base.astro';

// /pricing: the published price list the HubSpot Technology Partner
// (App Marketplace) listing has to match. HubSpot requires listing pricing to
// match the website, so every number and feature below must stay identical
// to the listing. Change one, change both.
//
// Copy source: plan doc v5, §4 ("Product tiers and pricing"): tier names,
// prices, onboarding charges, the "who it's for" lines, and the scope
// language. The tier facts themselves are the locked set Jon approved; where
// §4 and the locked set ever differ, the locked set wins.
//
// Deliberately names no seller or employer, the same choice /about makes.
// Deliberately has no call links or booking links (§4.5 operating rule).
//
// CTAs are PLACEHOLDERS. The payment links don't exist yet. Each plan's
// `checkoutHref` is '#' and the button renders aria-disabled with pointer
// events off. TODO(payment-links): when the payment links exist, set
// checkoutHref per plan, drop `disabled`, and remove the "not yet available"
// note.

const title = 'Pricing: HubSpot Health Subscription — Jon Martin';
const description =
	'Pulse $100/mo, Guard $250/mo, Assist $500/mo. Automated HubSpot audits, health scores, credit and seat alerts, and catalog auto-fixes. No consulting.';

const plans = [
	{
		id: 'pulse',
		name: 'Pulse',
		monthly: 100,
		annual: 1000,
		onboarding: 0,
		forWho: "Small Starter teams that want to know when something's off.",
		lead: undefined,
		features: [
			'Monthly audit and health score',
			'Credit & Seat Watch: a credit and seat report, with alerts',
			'Monthly digest of new HubSpot betas and updates for your hubs and edition',
			'Data cleanup: findings only (no writes)',
			'Product email support within 2 business days',
		],
		// TODO(payment-links): Pulse payment link goes here.
		checkoutHref: '#',
		disabled: true,
	},
	{
		id: 'guard',
		name: 'Guard',
		monthly: 250,
		annual: 2500,
		onboarding: 99,
		forWho: 'Starter/Pro teams that want issues fixed automatically.',
		lead: undefined,
		features: [
			'Weekly audits and health score',
			'Same-day credit and seat alerts, with inactive-seat flags',
			'Weekly beta digest, each item flagged for whether it fits your portal and what it would affect',
			'Auto-fixes from a set catalog, up to 500 records a month, read back and logged',
			'5 catalog fix requests a month',
			'Product email support within 2 business days',
		],
		// TODO(payment-links): Guard payment link goes here.
		checkoutHref: '#',
		disabled: true,
	},
	{
		id: 'assist',
		name: 'Assist',
		monthly: 500,
		annual: 5000,
		onboarding: 299,
		forWho: 'Pro teams that want a CRM assistant their reps can talk to.',
		lead: 'Everything in Guard, plus:',
		features: [
			'Daily critical checks',
			'A quarterly memo on credit packs vs pay-as-you-go',
			'Catalog cleanup up to 2,000 records a month',
			'15 catalog fix requests a month',
			'Priority support',
			'Grok CRM Assistant included',
			'Grok CRM Assistant answers “should we turn this on?” with an opt-in checklist you follow yourself',
		],
		// TODO(payment-links): Assist payment link goes here.
		checkoutHref: '#',
		disabled: true,
	},
];

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

// Product + one Offer per plan and billing period. No `seller`/`brand` on
// purpose (see header). No `availability`: checkout isn't open yet, and
// claiming InStock for a plan nobody can buy would be a false statement.
// Onboarding charges are named in each Offer's description, not modeled as a
// price component, so `price` is always the recurring price the card shows.
const url = 'https://thejonmartin.com/pricing';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	'@id': `${url}#product`,
	name: 'HubSpot Health Subscription',
	description:
		'An automated HubSpot health subscription: scheduled audits and health scores, credit and seat alerts, and auto-fixes limited to a set catalog. No consulting, builds or retainers.',
	url,
	offers: plans.flatMap((plan) => {
		const onboardingNote =
			plan.onboarding > 0 ? ` Plus a ${usd(plan.onboarding)} one-time onboarding charge.` : '';
		return [
			{
				'@type': 'Offer',
				name: `${plan.name} (monthly)`,
				description: `${plan.name}: ${usd(plan.monthly)} per month.${onboardingNote}`,
				url: `${url}#${plan.id}`,
				price: String(plan.monthly),
				priceCurrency: 'USD',
				priceSpecification: {
					'@type': 'UnitPriceSpecification',
					price: String(plan.monthly),
					priceCurrency: 'USD',
					billingDuration: 'P1M',
				},
			},
			{
				'@type': 'Offer',
				name: `${plan.name} (annual)`,
				description: `${plan.name}: ${usd(plan.annual)} per year, paid upfront.${onboardingNote}`,
				url: `${url}#${plan.id}`,
				price: String(plan.annual),
				priceCurrency: 'USD',
				priceSpecification: {
					'@type': 'UnitPriceSpecification',
					price: String(plan.annual),
					priceCurrency: 'USD',
					billingDuration: 'P1Y',
				},
			},
		];
	}),
};
---

<Base title={title} description={description} schema={schema} navBordered={false}>
	<main id="main">
		<section class="band hero">
			<div class="inner">
				<div class="edge">
					<div class="meta">
						<div class="cell accent">Pricing</div>
						<div class="cell">Pulse / Guard / Assist</div>
						<div class="cell">Monthly or annual</div>
						<div class="cell">Automated</div>
					</div>
					<h1>Pricing for the automated HubSpot health subscription.</h1>
					<p class="dek">
						Scheduled audits and health scores, Credit &amp; Seat Watch alerts, and auto-fixes limited to a set catalog. Everything below runs automatically.
					</p>
				</div>
			</div>
		</section>

		<section class="band plans-band" aria-labelledby="plans-heading">
			<div class="inner">
				<div class="plans-head">
					<span class="label section-label">01 / Plans</span>
					<div class="rule"></div>
					<h2 id="plans-heading">Three plans: Pulse, Guard and Assist.</h2>
				</div>
				<div class="plans">
					{plans.map((plan) => (
						<article class="plan" id={plan.id} aria-labelledby={`${plan.id}-name`}>
							<h3 class="label plan-name" id={`${plan.id}-name`}>{plan.name}</h3>
							<p class="price">
								<span class="amount">{usd(plan.monthly)}</span><span class="per">/mo</span>
							</p>
							<p class="label terms">
								{plan.onboarding > 0
									? `+ ${usd(plan.onboarding)} one-time onboarding`
									: 'No onboarding charge'}
							</p>
							<p class="label terms annual">
								Or {usd(plan.annual)}/yr, paid upfront
							</p>
							<p class="for-who">{plan.forWho}</p>
							{plan.lead && <p class="lead">{plan.lead}</p>}
							<ul class="features">
								{plan.features.map((feature) => <li>{feature}</li>)}
							</ul>
							<div class="cta">
								{/* TODO(payment-links): placeholder CTA. Replace checkoutHref with the real payment link and remove aria-disabled / the note below. */}
								<a
									class="btn btn-primary"
									href={plan.checkoutHref}
									aria-disabled={plan.disabled ? 'true' : undefined}
									data-plan={plan.id}
									data-placeholder="payment-link"
								>
									Choose {plan.name}
								</a>
								{plan.disabled && <p class="label cta-note">Checkout not yet available</p>}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">02 / Annual</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					<p class="lede">Pay 12 months upfront and get 2 free: annual plans are 10× the monthly price.</p>
					<div class="spectable">
						{plans.map((plan) => (
							<div class="spec">
								<span class="label spec-label">{plan.name}</span>
								<span class="spec-value">{usd(plan.annual)}/yr</span>
							</div>
						))}
					</div>
					<p class="small">Onboarding charges stay one-time.</p>
				</div>
			</div>
		</section>

		<section class="band offer" aria-labelledby="not-heading">
			<div class="inner">
				<p class="label offer-label" id="not-heading">What this is not</p>
				<p class="offer-statement">An automated product. No consulting, no builds, no retainers.</p>
				<p class="offer-detail">No plan includes custom builds, implementation or onboarding projects, strategy consulting, or hourly or retainer service work.</p>
				<p class="offer-detail">We never turn on betas for you; you opt in yourself.</p>
			</div>
		</section>

		<section class="band">
			<div class="inner ledger">
				<div class="rail">
					<span class="label section-label">03 / Fine print</span>
					<div class="rule"></div>
				</div>
				<div class="content">
					<div class="fixrow"><span class="label fix-n">01</span><p>Onboarding charges are automated and self-serve, charged once at checkout.</p></div>
					<div class="fixrow"><span class="label fix-n">02</span><p>Auto-fixes and fix requests cover catalog fixes only, within each plan's record limit.</p></div>
					<div class="fixrow"><span class="label fix-n">03</span><p>Product support covers the app, reports, bugs and billing. It is not HubSpot consulting.</p></div>
					<div class="fixrow"><span class="label fix-n">04</span><p>You keep paying for your own HubSpot and Grok seats.</p></div>
				</div>
			</div>
		</section>
	</main>
</Base>

<style>
	/* Band / ledger / hero / offer patterns mirror src/pages/hubspot-facing.astro
	   so the two offer pages read as one system. Tokens come from
	   shared/styles/field-and-ledger.css. */
	.band { padding: 88px 0; border-top: 1px solid var(--hairline); }
	.band:first-child { border-top: none; }
	.inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
	.ledger { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr); gap: 56px; }
	.rail { position: sticky; top: 24px; align-self: start; }
	.section-label { font-size: 12px; color: var(--sage); display: block; margin-bottom: 0.75rem; }
	.rule { width: 40px; height: 2px; background: var(--mustard); }

	.hero { background: var(--plum); color: var(--cream); padding: 72px 0 80px; }
	.hero .edge { border-left: 1px solid var(--hairline-on-plum); padding-left: 18px; }
	.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-bottom: 1px solid var(--hairline-on-plum); margin-bottom: 40px; }
	.cell { padding: 14px 18px; font-family: 'Courier New', Cousine, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--label-on-plum); border-right: 1px solid var(--hairline-on-plum); }
	.cell.accent { color: var(--mustard); }
	.hero h1 { color: var(--cream); font-size: clamp(36px, 5.6vw, 72px); font-weight: 400; line-height: 1.04; letter-spacing: -0.02em; max-width: 20ch; text-wrap: pretty; margin: 0 0 32px; }
	.dek { font-size: 19px; line-height: 1.6; color: var(--body-on-plum); margin: 0; max-width: 60ch; }

	.plans-head { margin-bottom: 40px; }
	.plans-head .rule { margin-bottom: 1.25rem; }
	.plans-head h2 { font-size: clamp(26px, 3.2vw, 38px); line-height: 1.15; max-width: 30ch; }
	.plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--hairline); background: var(--white); }
	.plan { display: flex; flex-direction: column; padding: 32px 28px; border-left: 1px solid var(--hairline); }
	.plan:first-child { border-left: none; }
	.plan-name { font-size: 13px; letter-spacing: 0.16em; color: var(--sage); margin: 0 0 1rem; font-family: 'Courier New', Cousine, monospace; }
	.price { margin: 0 0 0.75rem; color: var(--plum); font-family: Georgia, Gelasio, serif; line-height: 1; }
	.amount { font-size: clamp(44px, 4.4vw, 56px); letter-spacing: -0.02em; }
	.per { font-size: 20px; margin-left: 4px; color: var(--muted); }
	.terms { font-size: 11px; letter-spacing: 0.1em; color: var(--dark-mustard); margin: 0 0 0.35rem; }
	.terms.annual { color: var(--muted); }
	.for-who { font-family: Georgia, Gelasio, serif; font-size: 18px; line-height: 1.4; color: var(--plum); margin: 1.25rem 0 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--hairline); }
	.lead { font-size: 15px; font-weight: 700; margin: 0 0 0.25rem; }
	.features { list-style: none; margin: 0 0 1.75rem; padding: 0; }
	.features li { font-size: 16px; line-height: 1.45; padding: 10px 0 10px 22px; border-top: 1px solid var(--hairline); position: relative; }
	.features li:first-child { border-top: none; }
	.features li::before { content: ''; position: absolute; left: 0; top: 19px; width: 10px; height: 2px; background: var(--mustard); }
	.cta { margin-top: auto; }
	.btn { display: inline-block; font-family: 'Courier New', Cousine, monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; padding: 16px 26px; text-decoration: none; text-align: center; }
	.btn-primary { background: var(--mustard); color: var(--plum); }
	.btn-primary:hover { background: var(--plum); color: var(--cream); }
	/* Placeholder state: visibly inert until a real payment link replaces '#'. */
	.btn[aria-disabled='true'] { pointer-events: none; cursor: not-allowed; background: transparent; color: var(--muted); border: 1px solid var(--hairline); }
	.cta .btn { display: block; width: 100%; }
	.cta-note { font-size: 11px; color: var(--muted); margin: 0.6rem 0 0; text-align: center; }

	.lede { font-size: 21px; line-height: 1.55; max-width: 60ch; margin: 0 0 1.5rem; }
	.content p { font-size: 18px; line-height: 1.55; max-width: 62ch; }
	.small { font-size: 16px !important; color: var(--muted); margin: 1.25rem 0 0; }
	.spectable { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
	.spec { padding: 18px 0; }
	.spec-label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.spec-value { font-family: Georgia, Gelasio, serif; font-size: 26px; color: var(--plum); }

	.offer { background: var(--mustard); padding: 56px 0; border-top: none; }
	.offer-label { font-size: 11px; letter-spacing: 0.18em; color: var(--mustard-shade); margin: 0 0 0.75rem; }
	.offer-statement { font-family: Georgia, Gelasio, serif; font-size: clamp(26px, 4vw, 44px); line-height: 1.14; max-width: 28ch; color: var(--charcoal); margin: 0 0 1rem; }
	.offer-detail { font-size: 18px; line-height: 1.55; max-width: 62ch; color: var(--charcoal); margin: 0; }
	.offer-detail + .offer-detail { margin-top: 0.75rem; }

	.fixrow { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding: 22px 0; border-top: 1px solid var(--hairline); align-items: start; }
	.fixrow:first-child { border-top: none; }
	.fix-n { font-size: 13px; color: var(--sage); padding-top: 4px; }
	.fixrow p { margin: 0; }

	@media (max-width: 960px) {
		.plans { grid-template-columns: 1fr; }
		.plan { border-left: none; border-top: 1px solid var(--hairline); }
		.plan:first-child { border-top: none; }
	}
	@media (max-width: 720px) {
		.inner { padding: 0 20px; }
		.band { padding: 56px 0; }
		.hero { padding: 48px 0 56px; }
		.ledger { grid-template-columns: 1fr; gap: 28px; }
		.rail { position: static; }
		.plan { padding: 28px 22px; }
	}
</style>
