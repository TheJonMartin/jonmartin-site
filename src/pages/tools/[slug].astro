---
import Base from '../../layouts/Base.astro';
import { tools, disclosure, CHECKED, PUBLISHED, MODIFIED, type Block } from '../../lib/tools';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
	return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const canonical = new URL(`/tools/${tool.slug}`, Astro.site).href;
// -v2: re-rendered Oct 28 without the HubSpot line; new name busts cached previews (old files kept).
const ogImage = `/og/tools/${tool.slug}-v2.png`;
const pad = (n: number) => String(n).padStart(2, '0');

const relatedTools = (tool.related ?? [])
	.map((slug) => tools.find((t) => t.slug === slug))
	.filter((t): t is (typeof tools)[number] => Boolean(t));

const breadcrumb = breadcrumbSchema(tool.name, canonical, Astro.site!.href, {
	name: 'Tools',
	url: new URL('/tools', Astro.site).href,
});

const hasProsCons = tool.pros.length > 0 || tool.cons.length > 0;
const allSections = [
	...tool.sections,
	...(hasProsCons ? [{ label: 'Pros and cons', blocks: [] as Block[], proscons: true }] : []),
	...(tool.after ?? []),
];

// Per-page overrides; pages without them use the shared defaults.
const checked = tool.checked ?? CHECKED;
const published = tool.published ?? PUBLISHED;
const modified = tool.modified ?? MODIFIED;
const disclosureText = tool.disclosure ?? disclosure;
const metaCells = tool.metaCells ?? ['Tool review', tool.category, `Checked ${checked}`, 'Affiliate link'];
const tryLede = tool.tryLede === undefined ? `If this fits your stack, you can start with ${tool.name} here.` : tool.tryLede;
const ctas = [tool.cta, ...(tool.moreCtas ?? [])];
const faq = tool.faq ?? [];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': canonical,
	headline: tool.h1,
	name: tool.title,
	description: tool.description,
	url: canonical,
	datePublished: published,
	dateModified: modified,
	author: { '@type': 'Person', '@id': 'https://thejonmartin.com/#jon', name: 'Jon Martin' },
	publisher: { '@type': 'Person', '@id': 'https://thejonmartin.com/#jon', name: 'Jon Martin' },
	image: new URL(ogImage, Astro.site).href,
	inLanguage: 'en-US',
	about: tool.about ? tool.about.map((name) => ({ '@type': 'Thing', name })) : { '@type': 'Thing', name: tool.name },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

// One list renders the visible FAQ and the JSON-LD, so the text always matches.
const faqSchema =
	faq.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				'@id': `${canonical}#faq`,
				mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
			}
		: null;
const schemas = faqSchema ? [breadcrumb, schema, faqSchema] : [breadcrumb, schema];
---

<Base title={tool.title} seoTitle={tool.seoTitle} description={tool.description} schema={schemas} navBordered={false} ogImage={ogImage} ogType="article" publishedTime={published} modifiedTime={modified}>
	<main id="main">
		<section class="band hero">
			<div class="inner">
				<div class="edge">
					<div class="meta">
						{metaCells.map((c, n) => <div class:list={['cell', { accent: n === 0 }]}>{c}</div>)}
					</div>
					<h1>{tool.h1}</h1>
					<div class="dekcol">
						{tool.dek.map((line) => <p class="dek">{line}</p>)}
					</div>
				</div>
			</div>
		</section>

		<div class="disclosure-bar">
			<div class="inner">
				<p class="label disclosure-top"><span class="d-tag">Disclosure</span> {disclosureText}</p>
			</div>
		</div>

		<section class="band facts">
			<div class="inner">
				{tool.factsTable ? (
					<div class="tablewrap">
						<table class="cmp facts-cmp">
							<thead>
								<tr>{tool.factsTable.head.map((h) => <th scope="col">{h}</th>)}</tr>
							</thead>
							<tbody>
								{tool.factsTable.rows.map((r) => (
									<tr>
										<th scope="row" class="label">{r[0]}</th>
										{r.slice(1).map((c) => <td>{c}</td>)}
									</tr>
								))}
							</tbody>
						</table>
					</div>
				) : (
					<div class="spectable">
						{tool.facts.map((f) => (
							<div class="spec">
								<span class="label spec-label">{f.label}</span>
								<span class:list={['spec-value', { flag: f.flag }]}>{f.value}</span>
							</div>
						))}
					</div>
				)}
			</div>
		</section>

		{allSections.map((section, i) => (
			<section class="band">
				<div class="inner ledger">
					<div class="rail">
						<h2 class="label section-label">{pad(i + 1)} / {section.label}</h2>
						<div class="rule"></div>
					</div>
					<div class="content">
						{'proscons' in section ? (
							<div class="proscons">
								<div class="pc">
									<h3 class="label pc-label pro">Pros</h3>
									<ul class="rows">
										{tool.pros.map((item) => <li>{item}</li>)}
									</ul>
								</div>
								<div class="pc">
									<h3 class="label pc-label con">Cons</h3>
									<ul class="rows">
										{tool.cons.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							</div>
						) : (
							section.blocks.map((block) => {
								if (block.type === 'p') return <p set:html={block.html} />;
								if (block.type === 'h3') return <h3 class="subhead">{block.text}</h3>;
								if (block.type === 'table')
									return (
										<figure class="tablefig">
											{block.caption && <figcaption class="tcap">{block.caption}</figcaption>}
											<div class="tablewrap">
												<table class="cmp">
													<thead>
														<tr>{block.head.map((h) => <th scope="col">{h}</th>)}</tr>
													</thead>
													<tbody>
														{block.rows.map((r) => (
															<tr>
																<th scope="row" set:html={r[0]} />
																{r.slice(1).map((c) => <td set:html={c} />)}
															</tr>
														))}
													</tbody>
												</table>
											</div>
										</figure>
									);
								if (block.type === 'ul')
									return <ul class="rows">{block.items.map((item) => <li set:html={item} />)}</ul>;
								return (
									<ol class="numbered">
										{block.items.map((item, n) => (
											<li>
												<span class="label n">{block.type === 'steps' ? `Step ${n + 1}` : pad(n + 1)}</span>
												<span class="item" set:html={item} />
											</li>
										))}
									</ol>
								);
							})
						)}
					</div>
				</div>
			</section>
		))}

		{faq.length > 0 && (
			<section class="band faq" id="faq">
				<div class="inner ledger">
					<div class="rail">
						<h2 class="label section-label">Common questions</h2>
						<div class="rule"></div>
					</div>
					<div class="content">
						<div class="faqlist">
							{faq.map((f) => (
								<div class="qa">
									<h3 class="q">{f.q}</h3>
									<p class="a">{f.a}</p>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>
		)}

		<section class="band offer">
			<div class="inner">
				<p class="label offer-label">The short version</p>
				{tool.closingIntro && <p class="offer-intro">{tool.closingIntro}</p>}
				<p class="offer-statement">{tool.closing}</p>
			</div>
		</section>

		<section class="band try" id="try">
			<div class="inner ledger">
				<div class="rail">
					<h2 class="label section-label try-label">Try it</h2>
					<div class="rule"></div>
				</div>
				<div class="content">
					{tryLede && <p class="try-lede">{tryLede}</p>}
					{tool.moreCtas ? (
						<div class="ctas">
							{ctas.map((c) => (
								<a class="btn btn-primary" href={c.href} target="_blank" rel="sponsored noopener noreferrer">{c.label} &rarr;</a>
							))}
						</div>
					) : (
						<a class="btn btn-primary" href={tool.cta.href} target="_blank" rel="sponsored noopener noreferrer">{tool.cta.label} &rarr;</a>
					)}
					{!tool.disclosureOnce && <p class="try-disclosure"><strong>Affiliate disclosure.</strong> {disclosureText}</p>}
				</div>
			</div>
		</section>

		<section class="band sources">
			<div class="inner ledger">
				<div class="rail">
					<h2 class="label section-label">Sources opened</h2>
					<div class="rule"></div>
				</div>
				<div class="content">
					{tool.sourcesNumbered ? (
						<ol class="srcs numbered">
							{tool.sources.map((s) => (
								<li>
									<a href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a>
									{(s.also ?? []).map((a) => (
										<>
											{' · '}
											<a href={a.href} target="_blank" rel="noopener noreferrer">{a.text}</a>
										</>
									))}
								</li>
							))}
						</ol>
					) : (
						<ul class="srcs">
							{tool.sources.map((s) => (
								<li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a></li>
							))}
						</ul>
					)}
					{tool.disclaimer ? (
						<p class="disclaimer">{tool.disclaimer}</p>
					) : (
						<p class="disclaimer">Figures and listing details were checked on {checked} and can change. Confirm current plans and pricing on the vendor's site before you buy.</p>
					)}
				</div>
			</div>
		</section>
			{relatedTools.length > 0 && (
				<section class="band related">
					<div class="inner ledger">
						<div class="rail">
							<h2 class="label section-label">Related tools</h2>
							<div class="rule"></div>
						</div>
						<div class="content">
							<ul class="rows relrows">
								{relatedTools.map((r) => (
									<li>
										<a href={`/tools/${r.slug}`}><strong>{r.name}</strong></a>
										<span class="reldesc">{r.description}</span>
									</li>
								))}
								<li><a class="allrow" href="/tools">All tools <span aria-hidden="true">&rarr;</span></a></li>
							</ul>
						</div>
					</div>
				</section>
			)}
	</main>
</Base>

<style>
	.band { padding: 80px 0; border-top: 1px solid var(--hairline); }
	.band:first-child { border-top: none; }
	.inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
	.ledger { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr); gap: 56px; }
	.rail { position: sticky; top: 24px; align-self: start; }
	.section-label { font-size: 12px; font-weight: 400; line-height: 1.4; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sage); display: block; margin: 0 0 0.75rem; }
	.rule { width: 40px; height: 2px; background: var(--mustard); }

	/* hero */
	.hero { background: var(--plum); color: var(--cream); padding: 72px 0 80px; }
	.hero .edge { border-left: 1px solid var(--hairline-on-plum); padding-left: 18px; }
	.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-bottom: 1px solid var(--hairline-on-plum); margin-bottom: 40px; }
	.cell { padding: 14px 18px; font-family: 'Courier New', Cousine, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--label-on-plum); border-right: 1px solid var(--hairline-on-plum); }
	.cell.accent { color: var(--mustard); }
	.hero h1 { color: var(--cream); font-size: clamp(36px, 5.6vw, 72px); font-weight: 400; line-height: 1.04; letter-spacing: -0.02em; max-width: 20ch; text-wrap: balance; margin: 0 0 36px; }
	.dekcol { display: grid; gap: 14px; max-width: 62ch; }
	.dek { font-size: 19px; line-height: 1.6; color: var(--body-on-plum); margin: 0; }

	/* disclosure under hero */
	.disclosure-bar { border-bottom: 1px solid var(--hairline); padding: 14px 0; background: var(--white); }
	.disclosure-top { font-size: 11px; line-height: 1.6; color: var(--muted); margin: 0; letter-spacing: 0.06em; }
	.d-tag { color: var(--plum); margin-right: 0.5rem; }

	/* fact strip */
	.facts { padding: 40px 0; border-top: none; }
	.spectable { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0 28px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
	.spec { padding: 18px 0; }
	.spec-label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 0.4rem; }
	.spec-value { font-family: Georgia, Gelasio, serif; font-size: 20px; line-height: 1.3; color: var(--plum); }
	.spec-value.flag { color: var(--dark-mustard); }

	/* body */
	.content p { font-size: 18px; line-height: 1.6; max-width: 62ch; margin: 0 0 1.1rem; }
	.content p:last-child { margin-bottom: 0; }
	.content :global(strong) { color: var(--plum); font-weight: 700; }

	.rows { list-style: none; margin: 0 0 1.25rem; padding: 0; max-width: 66ch; }
	.rows li { font-size: 18px; line-height: 1.55; padding: 16px 0; border-top: 1px solid var(--hairline); }
	.rows li:first-child { border-top: none; padding-top: 0; }
	.rows li:last-child { padding-bottom: 0; }

	.numbered { list-style: none; margin: 0 0 1.25rem; padding: 0; max-width: 70ch; }
	.numbered li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 20px; padding: 22px 0; border-top: 1px solid var(--hairline); align-items: start; }
	.numbered li:first-child { border-top: none; padding-top: 0; }
	.numbered li:last-child { padding-bottom: 0; }
	.n { font-size: 13px; color: var(--sage); padding-top: 4px; }
	.item { font-size: 18px; line-height: 1.55; }

	.subhead { font-family: Georgia, Gelasio, serif; font-size: 24px; font-weight: 400; line-height: 1.25; color: var(--plum); margin: 2.25rem 0 0.9rem; }
	.content .subhead:first-child { margin-top: 0; }

	/* tables (comparison strip and in-section tables) */
	.tablefig { margin: 1.75rem 0; }
	.tcap { font-family: Georgia, Gelasio, serif; font-weight: 700; font-size: 18px; color: var(--plum); margin: 0 0 0.75rem; }
	.tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
	.cmp { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; min-width: 560px; }
	.cmp th, .cmp td { text-align: left; vertical-align: top; padding: 12px 14px 12px 0; border-top: 1px solid var(--hairline); }
	.cmp thead th { font-family: 'Courier New', Cousine, monospace; font-size: 11px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); border-top: none; padding-top: 0; }
	.cmp tbody th { font-weight: 700; color: var(--plum); }
	.facts-cmp { border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
	.facts-cmp thead th { padding-top: 14px; }
	.facts-cmp tbody th { font-family: 'Courier New', Cousine, monospace; font-size: 11px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); width: 18%; }
	.facts-cmp td { font-family: Georgia, Gelasio, serif; font-size: 18px; line-height: 1.35; color: var(--plum); width: 41%; }

	/* FAQ */
	.faqlist { max-width: 66ch; }
	.qa { padding: 22px 0; border-top: 1px solid var(--hairline); }
	.qa:first-child { border-top: none; padding-top: 0; }
	.q { font-family: Georgia, Gelasio, serif; font-size: 21px; font-weight: 400; line-height: 1.3; color: var(--plum); margin: 0 0 0.6rem; }
	.content p.a { font-size: 17px; margin: 0; }

	.proscons { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; }
	.pc { min-width: 0; }
	.pc-label { font-size: 12px; font-weight: 400; line-height: 1.4; letter-spacing: 0.16em; text-transform: uppercase; display: block; margin: 0 0 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--hairline); }
	.pc-label.pro { color: var(--sage); }
	.pc-label.con { color: var(--dark-mustard); }
	.pc .rows li { font-size: 17px; }

	/* closing band */
	.offer { background: var(--mustard); padding: 56px 0; border-top: none; }
	.offer-label { font-size: 11px; letter-spacing: 0.18em; color: var(--mustard-shade); margin: 0 0 0.75rem; }
	.offer-intro { font-size: 19px; line-height: 1.55; max-width: 60ch; color: var(--charcoal); margin: 0 0 1.25rem; }
	.offer-statement { font-family: Georgia, Gelasio, serif; font-size: clamp(26px, 4vw, 44px); line-height: 1.14; max-width: 26ch; color: var(--charcoal); margin: 0; text-wrap: balance; }

	/* try it */
	.try { background: var(--plum); color: var(--cream); border-top: none; }
	.try-label { color: var(--mustard); }
	.try .content p.try-lede { font-size: 21px; color: var(--cream); margin: 0 0 1.5rem; }
	.btn { display: inline-block; font-family: 'Courier New', Cousine, monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; padding: 16px 26px; text-decoration: none; }
	.btn-primary { background: var(--mustard); color: var(--plum); }
	.btn-primary:hover { background: var(--cream); color: var(--plum); }
	.btn:focus-visible { outline: 2px solid var(--cream); outline-offset: 3px; }
	.ctas { display: flex; flex-wrap: wrap; gap: 14px; }
	.try .content p.try-disclosure { font-size: 15px; color: var(--body-on-plum); margin: 1.5rem 0 0; }
	.try-disclosure :global(strong) { color: var(--cream); }

	/* sources */
	.sources { padding: 56px 0 72px; }
	.srcs { list-style: none; margin: 0 0 1rem; padding: 0; }
	.srcs li { padding: 10px 0; border-top: 1px solid var(--hairline); font-size: 16px; overflow-wrap: anywhere; }
	.srcs li:first-child { border-top: none; padding-top: 0; }
	.srcs.numbered { list-style: decimal; padding-left: 1.6rem; }
	.disclaimer { font-size: 13px !important; color: var(--muted); }

	/* related tools */
	.related { padding: 56px 0 72px; }
	.relrows a { color: var(--plum); text-decoration: none; border-bottom: 1px solid var(--mustard); }
	.relrows a:hover { background: var(--white); }
	.relrows a:focus-visible { outline: 2px solid var(--plum); outline-offset: 2px; }
	.relrows .allrow { font-family: 'Courier New', Cousine, monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; }
	.reldesc { display: block; font-size: 16px; line-height: 1.5; color: var(--muted); margin-top: 0.35rem; }

	@media (max-width: 720px) {
		.inner { padding: 0 20px; }
		.band { padding: 56px 0; }
		.ledger { grid-template-columns: 1fr; gap: 28px; }
		.rail { position: static; }
		.numbered li { grid-template-columns: 56px minmax(0, 1fr); gap: 14px; }
		.cell { border-right: none; }
	}
</style>
