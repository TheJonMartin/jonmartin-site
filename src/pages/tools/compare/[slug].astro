---
import PseoPage from '../../../components/pseo/PseoPage.astro';
import { pagesFor, type PseoPage as PseoPageData } from '../../../lib/pseo';

export function getStaticPaths() {
	return pagesFor('compare').map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: PseoPageData };
---

<PseoPage page={page} />
