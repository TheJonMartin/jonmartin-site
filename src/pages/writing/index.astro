---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import writingPage from '../../content/pages/writing.json';
import { readingTime, entryNumbers } from '../../lib/writing';

const title = 'Writing — Jon Martin';
const description =
	'Notes on org design, systems, and why the things you built keep breaking.';

// Drafts never render. Newest first.
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const numbers = entryNumbers(posts);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const entryWord = posts.length === 1 ? 'entry' : 'entries';

const canonical = new URL('/writing', Astro.site).href;

// Built from the same `posts` array the page itself renders, rather than
// hand-maintained separately — a listing's ItemList that could drift from
// the list a visitor actually sees would be worse than no schema at all.
const schema =
	posts.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'CollectionPage',
				'@id': canonical,
				name: title,
				description,
				url: canonical,
				isPartOf: { '@id': 'https://thejonmartin.com/#website' },
				mainEntity: {
					'@type': 'ItemList',
					itemListElement: posts.map((post, i) => ({
						'@type': 'ListItem',
						position: i + 1,
						url: new URL(`/writing/${post.id}`, Astro.site).href,
					})),
				},
			}
		: undefined;
---

<Base title={title} description={description} schema={schema}>
	<main id="main">
		<div class="shell">
			<section class="masthead">
				<div class="rail">
					<span class="label index-word">Index</span>
					<span class="label count">{posts.length} {entryWord}</span>
				</div>
				<div class="content">
					<h1>Writing</h1>
					<p class="standfirst">{writingPage.standfirst}</p>
				</div>
			</section>

			<hr class="hairline" />

			{
				posts.length === 0 ? (
					<p class="empty">Nothing published yet. The first pieces are being written.</p>
				) : (
					<ul class="list">
						{posts.map((post) => (
							<li>
								<a class="postrow" href={`/writing/${post.id}`}>
									<div class="rail">
										<span class="label post-n">{numbers.get(post.id)}</span>
										<span class="label post-date">{fmt(post.data.pubDate)}</span>
										<span class="label post-time">{readingTime(post.body ?? '')}</span>
									</div>
									<div class="content">
										<h2>{post.data.title}</h2>
										<p class="desc">{post.data.description}</p>
										<span class="label read-more">Read &rarr;</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</main>
</Base>

<style>
	main { padding: 2.5rem 0 4rem; }
	.shell { max-width: 1200px; margin: 0 auto; padding: 0 40px; }

	.masthead { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr); gap: 56px; align-items: end; padding: 40px 0 48px; }
	.masthead .rail { display: flex; flex-direction: column; gap: 0.5rem; }
	.index-word { font-size: 11px; color: var(--sage); }
	.count { font-size: 11px; color: var(--muted); }
	h1 { font-size: clamp(38px, 6vw, 72px); line-height: 1.04; letter-spacing: -0.02em; margin: 0 0 0.75rem; }
	.standfirst { font-size: 20px; line-height: 1.55; max-width: 56ch; margin: 0; }

	.list { list-style: none; margin: 0; padding: 0; }
	.postrow {
		display: grid;
		grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr);
		gap: 56px;
		padding: 40px 0;
		border-top: 1px solid var(--hairline);
		align-items: start;
		text-decoration: none;
		color: inherit;
	}
	li:first-child .postrow { border-top: none; }
	.postrow:hover { background: var(--white); }
	.postrow .rail { display: flex; flex-direction: column; gap: 10px; }
	.post-n { font-size: 12px; color: var(--sage); }
	.post-date { font-size: 11px; color: var(--muted); }
	.post-time { font-size: 11px; color: var(--dark-mustard); }
	h2 { font-size: clamp(24px, 3.2vw, 38px); line-height: 1.16; max-width: 34ch; margin: 0 0 0.75rem; }
	.desc { font-size: 18px; line-height: 1.55; max-width: 64ch; margin: 0 0 1rem; color: var(--charcoal); }
	.read-more { font-size: 12px; color: var(--plum); border-bottom: 1px solid var(--mustard); padding-bottom: 2px; width: fit-content; display: block; }

	.empty { font-family: 'Courier New', Cousine, monospace; font-size: 0.9rem; color: var(--muted); margin: 2rem 0; }

	@media (max-width: 720px) {
		.shell { padding: 0 20px; }
		.masthead,
		.postrow { grid-template-columns: 1fr; gap: 20px; align-items: start; }
	}
</style>
