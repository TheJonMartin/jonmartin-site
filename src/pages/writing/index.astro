---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const title = 'Writing — Jon Martin';
const description =
	'Notes on org design, systems, and why the things you built keep breaking.';

// Drafts never render. Newest first.
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL('/writing', Astro.site).href;

// Built from the same `posts` array the page itself renders, rather than
// hand-maintained separately — a listing's ItemList that could drift from
// the list a visitor actually sees would be worse than no schema at all.
const schema =
	posts.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'CollectionPage',
				'@id': canonical,
				name: title,
				description,
				url: canonical,
				isPartOf: { '@id': 'https://thejonmartin.com/#website' },
				mainEntity: {
					'@type': 'ItemList',
					itemListElement: posts.map((post, i) => ({
						'@type': 'ListItem',
						position: i + 1,
						url: new URL(`/writing/${post.id}`, Astro.site).href,
					})),
				},
			}
		: undefined;
---

<Base title={title} description={description} schema={schema}>
	<main id="main">
		<section class="hero">
			<p class="label kicker"><a href="/">Jon Martin</a></p>
			<h1>Writing</h1>
			<p class="subhead">
				Notes on org design, systems, and why the things you built keep breaking.
			</p>
		</section>

		<hr class="hairline" />

		<section>
			{
				posts.length === 0 ? (
					<p class="empty">Nothing published yet. The first pieces are being written.</p>
				) : (
					<ul class="list">
						{posts.map((post) => (
							<li>
								<p class="label date">{fmt(post.data.pubDate)}</p>
								<h2><a href={`/writing/${post.id}`}>{post.data.title}</a></h2>
								<p class="desc">{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<p class="label tags">{post.data.tags.join(' · ')}</p>
								)}
							</li>
						))}
					</ul>
				)
			}
		</section>

		<hr class="hairline" />

		<footer>
			<p><a href="/">&larr; Back to the homepage</a></p>
			<p class="copyright">© 2026 Jon Martin.</p>
		</footer>
	</main>
</Base>

<style>
	/* Top padding was 5rem before the site had a persistent header nav; trimmed
	   to 2.5rem so content doesn't sit stacked below both the nav's own
	   padding and this. */
	main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
	.hero { display: flex; flex-direction: column; gap: 1.25rem; padding-bottom: 3rem; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	.kicker a { color: var(--sage); text-decoration: none; }
	.kicker a:hover { border-bottom: 1px solid var(--sage); }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); font-weight: 400; }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }
	section { padding: 3rem 0; }
	.list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2.5rem; }
	.date { font-size: 0.8rem; color: var(--sage); margin: 0 0 0.35rem; }
	h2 { font-size: 1.3rem; margin: 0 0 0.5rem; }
	h2 a { text-decoration: none; border-bottom: 1px solid rgba(74, 51, 82, 0.3); }
	h2 a:hover { border-bottom-color: var(--plum); }
	.desc { margin: 0; }
	.tags { font-size: 0.75rem; color: var(--sage); margin: 0.5rem 0 0; }
	.empty { font-family: 'Courier New', Courier, monospace; font-size: 0.9rem; opacity: 0.75; margin: 0; }
	footer { padding: 3rem 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
	footer a { font-family: 'Courier New', Courier, monospace; text-decoration: none; border-bottom: 1px solid var(--plum); }
	.copyright { font-size: 0.85rem; opacity: 0.6; margin: 0; }
</style>
