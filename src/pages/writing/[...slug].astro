---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('writing', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'writing'> };
const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(`/writing/${post.id}/`, Astro.site).href;

// BlogPosting rather than Article: it's the narrower type, and the narrower
// type is always the better answer when it fits. datePublished/dateModified are
// what put a date next to the result in search; author ties the post to the
// Person entity declared on the home page via the same @id.
const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': canonical,
	headline: post.data.title,
	description: post.data.description,
	url: canonical,
	datePublished: post.data.pubDate.toISOString(),
	...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
	author: { '@type': 'Person', '@id': 'https://thejonmartin.com/#jon', name: 'Jon Martin' },
	publisher: { '@type': 'Person', '@id': 'https://thejonmartin.com/#jon', name: 'Jon Martin' },
	image: new URL('/og.png', Astro.site).href,
	inLanguage: 'en-US',
	...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---

<Base
	title={`${post.data.title} — Jon Martin`}
	seoTitle={post.data.seoTitle}
	description={post.data.description}
	schema={schema}
>
	<main id="main">
		<article>
			<header class="head">
				<p class="label kicker"><a href="/writing/">Writing</a></p>
				<h1>{post.data.title}</h1>
				<p class="label date">
					{fmt(post.data.pubDate)}
					{post.data.updatedDate && <span> · updated {fmt(post.data.updatedDate)}</span>}
				</p>
			</header>

			<hr class="hairline" />

			<div class="prose">
				<Content />
			</div>

			{post.data.tags.length > 0 && (
				<p class="label tags">{post.data.tags.join(' · ')}</p>
			)}
		</article>

		<hr class="hairline" />

		<footer>
			<p><a href="/writing/">&larr; All writing</a></p>
			<p class="copyright">© 2026 Jon Martin.</p>
		</footer>
	</main>
</Base>

<style>
	/* Top padding was 5rem before the site had a persistent header nav; trimmed
	   to 2.5rem so content doesn't sit stacked below both the nav's own
	   padding and this. */
	main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
	.head { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 2.5rem; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	.kicker a { color: var(--sage); text-decoration: none; }
	.kicker a:hover { border-bottom: 1px solid var(--sage); }
	h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); font-weight: 400; }
	.date { font-size: 0.8rem; color: var(--sage); margin: 0; }
	.prose { padding: 2.5rem 0; }
	.tags { font-size: 0.75rem; color: var(--sage); margin: 0 0 2.5rem; }
	footer { padding: 3rem 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
	footer a { font-family: 'Courier New', Courier, monospace; text-decoration: none; border-bottom: 1px solid var(--plum); }
	.copyright { font-size: 0.85rem; opacity: 0.6; margin: 0; }
</style>

<style is:global>
	/* Markdown output. Scoped styles can't reach <Content /> children, so these
	   are global but namespaced under .prose. */
	.prose h2 { font-size: 1.4rem; margin: 2.5rem 0 1rem; }
	.prose h3 { font-size: 1.15rem; margin: 2rem 0 0.75rem; }
	.prose p { margin: 0 0 1.1rem; }
	.prose ul, .prose ol { margin: 0 0 1.1rem; padding-left: 1.4rem; }
	.prose li { margin-bottom: 0.4rem; }
	.prose blockquote {
		margin: 1.5rem 0;
		padding-left: 1.2rem;
		border-left: 2px solid var(--sage);
		font-family: 'Courier New', Courier, monospace;
		font-size: 0.95rem;
	}
	.prose code {
		font-family: 'Courier New', Courier, monospace;
		font-size: 0.92em;
		background: rgba(46, 42, 38, 0.06);
		padding: 0.1em 0.3em;
		border-radius: 2px;
	}
	.prose pre {
		background: rgba(46, 42, 38, 0.06);
		padding: 1rem;
		border-radius: 2px;
		overflow-x: auto;
	}
	.prose pre code { background: none; padding: 0; }
	.prose hr { border: none; border-top: 1px solid rgba(46, 42, 38, 0.15); margin: 2.5rem 0; }
	.prose img { max-width: 100%; height: auto; }

	/* Wide reference tables. The base table.ledger style lives in
	   shared/styles/field-and-ledger.css; everything here is the responsive
	   behaviour that only matters in a 680px prose column.

	   A six-column matrix cannot be a grid on a phone — at ~360px each column
	   gets 60px, which wraps every cell to one word per line and makes the
	   table less readable than no table at all. Horizontal scroll was the other
	   option and it hides columns behind a gesture most readers never make. So
	   below 700px each row becomes its own card and each cell carries its
	   column name from the data-label attribute. Markup stays a real <table>,
	   so it's still a table to a screen reader and to Google.

	   Any post using this must put data-label on every <td>. A missing one
	   renders as a value with no label on mobile. */
	.prose table.matrix { margin: 2rem 0; font-size: 0.9rem; }
	.prose table.matrix th { font-size: 0.85rem; }

	/* Mustard marks the outlier row — the system-admin tier that breaks the
	   seniority pattern and is the argument the post is actually making. One
	   mustard element on the page, which is the whole rule for the accent. */
	.prose table.matrix tr.outlier td { background: rgba(232, 169, 59, 0.12); }

	@media (max-width: 700px) {
		.prose table.matrix thead {
			/* Not display:none — that drops the header from the accessibility
			   tree along with the visual grid. Clipped instead, so assistive
			   tech still reads the column names. */
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.prose table.matrix tr {
			display: block;
			margin-bottom: 1.5rem;
			border: 1px solid var(--hairline);
			border-radius: 2px;
			padding: 0.25rem 0;
		}
		.prose table.matrix tr.outlier { border-color: var(--mustard); }
		.prose table.matrix td {
			display: grid;
			grid-template-columns: 8.5rem 1fr;
			gap: 0.75rem;
			border-bottom: none;
			padding: 0.35rem 0.75rem;
		}
		.prose table.matrix td::before {
			content: attr(data-label);
			font-family: 'Courier New', Courier, monospace;
			font-size: 0.7rem;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--sage);
			padding-top: 0.2rem;
		}
		/* The stakeholder name is the card's heading, so it gets the sage fill
		   the header row carries on desktop rather than a redundant label. */
		.prose table.matrix td:first-child {
			display: block;
			background: var(--sage);
			color: var(--cream);
			font-family: Georgia, 'Times New Roman', serif;
			padding: 0.5rem 0.75rem;
			margin-bottom: 0.35rem;
		}
		.prose table.matrix td:first-child::before { content: none; }
	}

	/* End-of-post resource block. Deliberately not a form: gating a one-page
	   PDF behind an email address costs more trust than the address is worth. */
	.prose .download {
		margin: 3rem 0 0;
		padding: 1.75rem;
		border: 1px solid var(--hairline);
		border-radius: 2px;
	}
	.prose .download .label {
		font-size: 0.75rem;
		color: var(--sage);
		margin: 0 0 0.5rem;
	}
	.prose .download p { margin: 0 0 1.25rem; font-size: 0.95rem; }
	.prose .download .button {
		display: inline-block;
		font-size: 1rem;
		color: var(--cream);
		background: var(--plum);
		border-radius: 2px;
		padding: 0.7rem 1.5rem;
		text-decoration: none;
	}
	.prose .download .button:hover { background: #3c2a43; }
	.prose .download .button:focus-visible {
		outline: 2px solid var(--charcoal);
		outline-offset: 2px;
	}
</style>
