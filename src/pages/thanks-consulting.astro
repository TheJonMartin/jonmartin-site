---
import Base from '../layouts/Base.astro';

// Where ConsultingInquiryForm.astro (embedded on /about) posts on success.
// Its own page rather than sharing /thanks (the homepage waitlist) or
// /thanks-contact (Four Laws' framework-corrections form) — each form makes
// a different promise, and this one is specifically "I'll reply about a
// consulting conversation," not "you're on a list" or "it'll show up in the
// document." See docs/site-consolidation.md for why that split exists.
//
// noindex because a confirmation page in search results is a dead end for
// whoever lands on it.

const title = 'Message sent — Jon Martin';
const description = 'Your consulting inquiry has been sent to Jon directly.';
---

<Base title={title} description={description} noindex={true}>
	<main id="main">
		<div class="shell">
			<section class="hero">
				<p class="label kicker">Received</p>
				<h1>That reached me.</h1>
				<p class="subhead">
					I read every one of these myself. If it's a fit, I'll reply directly to
					set up a conversation.
				</p>
				<hr class="hairline" />
				<p class="tagline">
					If you want to add anything in the meantime, just reply to this address:
					<a href="mailto:jon@thejonmartin.com">jon@thejonmartin.com</a>
				</p>
			</section>
		</div>
	</main>
</Base>

<style>
	main { padding: 2.5rem 0 4rem; }
	.shell { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
	.hero { display: flex; flex-direction: column; gap: 1.75rem; max-width: 62ch; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }
	.tagline { font-size: 1.1rem; margin: 0; }

	@media (max-width: 720px) {
		.shell { padding: 0 20px; }
	}
</style>
