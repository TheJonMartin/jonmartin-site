---
import Base from '../layouts/Base.astro';

const title = 'Request received — Steward Ledger';
const description = 'Your Steward Ledger information request has been received.';
---

<Base title={title} description={description} noindex={true}>
	<main id="main">
		<div class="shell">
			<section class="hero">
				<p class="label kicker">Received</p>
				<h1>Thanks, we've got it.</h1>
				<p class="subhead">
					I'll be in touch soon to answer your questions or set up a demo. In the meantime, the
					<a href="/steward-ledger#video">1-minute tour</a> covers the basics.
				</p>
			</section>
		</div>
	</main>
</Base>

<style>
	main { padding: 2.5rem 0 4rem; }
	.shell { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
	.hero { display: flex; flex-direction: column; gap: 1.75rem; max-width: 62ch; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }

	@media (max-width: 720px) {
		.shell { padding: 0 20px; }
	}
</style>
