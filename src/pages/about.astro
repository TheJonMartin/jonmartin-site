---
import Base from '../layouts/Base.astro';
import about from '../content/pages/about.json';

// Written from what's already public on this site, the Four Laws material,
// and the essay in /writing. Deliberately does not name an employer — Jon's
// current engagement is outside the scope of what this site represents, and
// that's a considered choice, not an oversight. Years in the field, concrete
// (anonymized) engagement examples, and whether the pastoral/seminary track
// belongs here are Jon's to add later; nothing here should be read as a gap
// waiting on a decision.
//
// Copy lives in src/content/pages/about.json so it's editable through the
// Decap CMS at /admin without touching this template. See docs/cms-setup.md.

const { title, description } = about;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	'@id': 'https://thejonmartin.com/about/',
	url: 'https://thejonmartin.com/about/',
	name: title,
	description,
	mainEntity: { '@id': 'https://thejonmartin.com/#jon' },
};
---

<Base title={title} description={description} schema={schema}>
	<main id="main">
		<section class="head">
			<p class="label kicker">{about.kicker}</p>
			<h1>{about.heroTitle}</h1>
			<p class="subhead">{about.subhead}</p>
		</section>

		<hr class="hairline" />

		{about.sections.map((section, i) => (
			<Fragment>
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
				</section>
				{i < about.sections.length - 1 && <hr class="hairline" />}
			</Fragment>
		))}

		<hr class="hairline" />

		<footer>
			<p class="links">
				<a href="/writing">Writing</a>
				<a href="mailto:jon@thejonmartin.com">jon@thejonmartin.com</a>
			</p>
			<p class="copyright">© {about.copyrightYear} Jon Martin.</p>
		</footer>
	</main>
</Base>

<style>
	main { max-width: 680px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
	.head { display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 3rem; }
	.kicker { font-size: 0.85rem; color: var(--sage); margin: 0; }
	h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); font-weight: 400; }
	.subhead { font-size: 1.15rem; max-width: 56ch; margin: 0; }
	section { padding: 3rem 0; }
	h2 { font-size: 1.4rem; margin-bottom: 1.25rem; }
	p { margin: 0 0 1.1rem; }
	p:last-child { margin-bottom: 0; }
	footer { padding: 3rem 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
	.links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
	footer a { font-family: "Courier New", Courier, monospace; text-decoration: none; border-bottom: 1px solid var(--plum); }
	.copyright { font-size: 0.85rem; opacity: 0.6; margin: 0; }
</style>
