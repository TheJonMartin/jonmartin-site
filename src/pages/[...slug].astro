---
import { getCollection, render } from 'astro:content';
import FourLawsLayout from '../layouts/FourLawsLayout.astro';
import CrossSiteCTA from '../components/CrossSiteCTA.astro';
import { articleSchema, faqSchema, glossarySchema } from '../lib/schema';

// One route for every markdown page in the fourLaws collection. The entry id
// is the filename without extension, which is also the URL — see the note in
// src/content.config.ts about why those are deliberately the same.
export async function getStaticPaths() {
	const pages = await getCollection('fourLaws', ({ data }) => !data.draft);
	return pages.map((page) => ({
		params: { slug: page.id },
		props: { page },
	}));
}

const { page } = Astro.props;
const { Content } = await render(page);

const canonical = new URL(`/${page.id}`, Astro.site).href;

// Schema is derived from the page's own markdown/front matter (see
// lib/schema.ts) rather than declared per-page, so it can't drift from the
// visible content. Two pages have a shape schema.org has more specific
// vocabulary for (FAQPage, DefinedTermSet); the 'meta' page (about) gets none,
// since a bio isn't an article; everything else — the long-form explore and
// reference prose — falls through to TechArticle.
let schema: Record<string, unknown> | undefined;
if (page.id === 'faq') {
	schema = faqSchema(page.body ?? '', canonical);
} else if (page.id === 'glossary') {
	schema = glossarySchema(page.body ?? '', canonical, Astro.site!.href);
} else if (page.data.group !== 'meta') {
	schema = articleSchema(page.data.title, page.data.description, canonical);
}

// The waitlist CTA goes on the pages someone reaches by reading, not on
// about/contact — those already have their own call to action, and stacking two
// asks on one page halves both.
const showCTA = page.data.group !== 'meta';
---

<FourLawsLayout
	title={page.data.title}
	seoTitle={page.data.seoTitle}
	description={page.data.description}
	schema={schema}
>
	<article>
		<span class="label eyebrow">{page.data.group}</span>
		<h1>{page.data.title}</h1>
		<Content />
	</article>

	{showCTA && <CrossSiteCTA />}
</FourLawsLayout>

<style>
	.eyebrow {
		font-size: 0.72rem;
		color: var(--muted);
		display: block;
		margin-bottom: 0.4rem;
	}
</style>
