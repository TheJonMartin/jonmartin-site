---
import { getCollection, render } from 'astro:content';
import FourLawsLayout from '../layouts/FourLawsLayout.astro';
import CrossSiteCTA from '../components/CrossSiteCTA.astro';
import { articleSchema, faqSchema, glossarySchema } from '../lib/schema';
import { withTermAnchors } from '../lib/glossary-anchors';

// One route for every markdown page in the fourLaws collection; the entry id
// (filename without extension) is the URL.
export async function getStaticPaths() {
	const pages = await getCollection('fourLaws', ({ data }) => !data.draft);
	return pages.map((page) => ({
		params: { slug: page.id },
		props: { page },
	}));
}

const { page } = Astro.props;
const { Content } = await render(page);

const canonical = new URL(`/${page.id}`, Astro.site).href;

// /glossary: same rendered markdown, plus an id on each term so the
// DefinedTerm url/@id (glossary#<slug>) resolves on the page.
const glossaryHtml =
	page.id === 'glossary' && page.rendered?.html ? withTermAnchors(page.rendered.html) : undefined;

// Schema is derived from the page's own markdown/front matter (see
// lib/schema.ts) rather than declared per-page, so it can't drift from the
// visible content. Two pages have a shape schema.org has more specific
// vocabulary for (FAQPage, DefinedTermSet); everything else — the long-form
// explore and reference prose — falls through to TechArticle.
let schema: Record<string, unknown> | undefined;
if (page.id === 'faq') {
	schema = faqSchema(page.body ?? '', canonical);
} else if (page.id === 'glossary') {
	schema = glossarySchema(page.body ?? '', canonical);
} else {
	schema = articleSchema(page.data.title, page.data.description, canonical);
}
---

<FourLawsLayout
	title={page.data.title}
	seoTitle={page.data.seoTitle}
	description={page.data.description}
	schema={schema}
>
	<article>
		<span class="label eyebrow">{page.data.group}</span>
		<h1>{page.data.title}</h1>
		{glossaryHtml ? <Fragment set:html={glossaryHtml} /> : <Content />}
	</article>

	<CrossSiteCTA />
</FourLawsLayout>

<style>
	.eyebrow {
		font-size: 0.72rem;
		color: var(--muted);
		display: block;
		margin-bottom: 0.4rem;
	}
</style>
