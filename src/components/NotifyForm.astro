---
// Netlify Forms capture for the pre-launch site.
//
// Nothing is bookable yet, so this isn't a "contact me" form — it's a waitlist
// that doubles as research. The "what's breaking" field is the valuable one:
// free-text from people who self-identified before launch is the cheapest seed
// data for the intake instrument.
//
// Netlify detects forms from the built HTML at deploy time, so this works with
// a static Astro build. Two requirements for that to happen:
//   1. Forms must be ENABLED on the Netlify project (jonmartin-mvp).
//   2. The hidden form-name input below must match the form's name attribute.
//
// The form is named "waitlist"; the radio group is named "interest". Those are
// deliberately different — a field sharing the form's name collides on submit.
//
// Submissions land in Netlify → Project → Forms → waitlist.
//
// `variant="band"` (the homepage's plum 05/Waitlist section) swaps the boxed
// cream-ground inputs for underline-only ones in cream-on-plum, per the brand/
// visual-system handoff. The "Not bookable yet" kicker moved to the section's
// own rail chip (see index.astro) — this component no longer renders its own,
// to avoid saying it twice.
interface Props {
	variant?: 'default' | 'band';
}
const { variant = 'default' } = Astro.props;
---

<section class="notify" id="notify" class:list={{ band: variant === 'band' }}>
	<h2>Tell me when it's ready.</h2>
	<p class="dek">
		I'm writing the first diagnoses now. Leave your email and you'll get the
		sample when it's finished — and the price when there is one.
	</p>

	<form
		name="waitlist"
		method="POST"
		action="/thanks/"
		data-netlify="true"
		netlify-honeypot="bot-field"
	>
		<input type="hidden" name="form-name" value="waitlist" />
		<p class="hp">
			<label>Leave this empty if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
		</p>

		<div class="row row-pair">
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" />
			</div>
			<div class="field">
				<label for="company">Company <span class="opt">(optional)</span></label>
				<input type="text" id="company" name="company" autocomplete="organization" />
			</div>
		</div>

		<fieldset class="row">
			<legend>Where are you right now?</legend>
			<label class="radio">
				<input type="radio" name="interest" value="Chronic" />
				<span>Something's been broken a while and I want to know what it actually is</span>
			</label>
			<label class="radio">
				<input type="radio" name="interest" value="Pre-signature" />
				<span>I'm about to commit to something large and want a second set of eyes</span>
			</label>
			<label class="radio">
				<input type="radio" name="interest" value="Not sure" checked />
				<span>Just keep me posted</span>
			</label>
		</fieldset>

		<div class="row">
			<label for="whats-breaking">
				What's actually breaking? <span class="opt">(optional — it's the part I read first)</span>
			</label>
			<textarea id="whats-breaking" name="whats-breaking" rows="4"
				placeholder="The hire who can't operate without you. The reports nobody trusts. Whatever it actually is."></textarea>
		</div>

		<button type="submit">Send &rarr;</button>
	</form>
</section>

<style>
	.notify { max-width: 62ch; }
	h2 { font-size: 1.4rem; margin-bottom: 1rem; }
	.dek { margin: 0 0 2rem; }
	form { display: flex; flex-direction: column; gap: 26px; }
	.row { display: flex; flex-direction: column; gap: 0.4rem; }
	.row-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; }
	label, legend { font-size: 0.95rem; font-weight: bold; color: var(--charcoal); padding: 0; }
	.opt { font-weight: normal; opacity: 0.65; }
	input[type='email'],
	input[type='text'],
	textarea {
		width: 100%;
		padding: 0.6rem 0.7rem;
		font: inherit;
		font-size: 1rem;
		color: var(--charcoal);
		background: #fffdf9;
		border: 1px solid rgba(74, 51, 82, 0.3);
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--plum);
		outline-offset: 1px;
		border-color: var(--plum);
	}
	textarea { resize: vertical; line-height: 1.5; }
	fieldset { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
	.radio {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr);
		gap: 14px;
		align-items: start;
		font-size: 0.95rem;
		font-weight: normal;
		line-height: 1.45;
		cursor: pointer;
		padding: 14px 0;
		border-top: 1px solid var(--hairline);
	}
	.radio input { margin-top: 5px; accent-color: var(--plum); }
	button {
		align-self: flex-start;
		font-family: 'Courier New', Cousine, monospace;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--cream);
		background: var(--plum);
		border: none;
		padding: 16px 30px;
		cursor: pointer;
	}
	button:hover { background: #3c2a43; }
	button:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }
	.hp { position: absolute; left: -9999px; }

	/* ---- band variant: cream text on plum, underline-only inputs ---- */
	.notify.band h2 { color: var(--cream); }
	.notify.band .dek { color: var(--body-on-plum); }
	.notify.band label,
	.notify.band legend { color: var(--label-on-plum); font-family: 'Courier New', Cousine, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; font-weight: normal; }
	.notify.band .opt { color: var(--label-on-plum); }
	.notify.band .radio { color: var(--body-on-plum); border-top-color: var(--hairline-on-plum); }
	.notify.band .radio input { accent-color: var(--mustard); }
	.notify.band input[type='email'],
	.notify.band input[type='text'] {
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--hairline-on-plum);
		padding: 9px 0;
		color: var(--cream);
	}
	.notify.band textarea {
		background: rgba(250, 246, 239, 0.06);
		border: 1px solid rgba(250, 246, 239, 0.3);
		padding: 12px;
		color: var(--cream);
	}
	.notify.band input:focus-visible,
	.notify.band textarea:focus-visible {
		outline: none;
		border-color: var(--mustard);
	}
	.notify.band button {
		background: var(--mustard);
		color: var(--plum);
	}
	.notify.band button:hover {
		background: var(--cream);
	}
</style>
