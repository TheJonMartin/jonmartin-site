---
// Hidden form-name input must match the form's name attribute ("waitlist").
// The radio group ("interest") must not share the form's name, or they collide on submit.
---

<section class="notify" id="notify">
	<h2>Tell me when it's ready.</h2>
	<p class="dek">
		I'm writing the first diagnoses now. Leave your email and you'll get the
		sample when it's finished — and the price when there is one.
	</p>

	<form
		name="waitlist"
		method="POST"
		action="/thanks/"
		data-netlify="true"
		netlify-honeypot="bot-field"
	>
		<input type="hidden" name="form-name" value="waitlist" />
		<p class="hp">
			<label>Leave this empty if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
		</p>

		<div class="row row-pair">
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" />
			</div>
			<div class="field">
				<label for="company">Company <span class="opt">(optional)</span></label>
				<input type="text" id="company" name="company" autocomplete="organization" />
			</div>
		</div>

		<fieldset class="row">
			<legend>Where are you right now?</legend>
			<label class="radio">
				<input type="radio" name="interest" value="Chronic" />
				<span>Something's been broken a while and I want to know what it actually is</span>
			</label>
			<label class="radio">
				<input type="radio" name="interest" value="Pre-signature" />
				<span>I'm about to commit to something large and want a second set of eyes</span>
			</label>
			<label class="radio">
				<input type="radio" name="interest" value="Not sure" checked />
				<span>Just keep me posted</span>
			</label>
		</fieldset>

		<div class="row">
			<label for="whats-breaking">
				What's actually breaking? <span class="opt">(optional — it's the part I read first)</span>
			</label>
			<textarea id="whats-breaking" name="whats-breaking" rows="4"
				placeholder="The hire who can't operate without you. The reports nobody trusts. Whatever it actually is."></textarea>
		</div>

		<button type="submit">Send &rarr;</button>
	</form>
</section>

<style>
	.notify { max-width: 62ch; }
	h2 { font-size: 1.4rem; margin-bottom: 1rem; color: var(--cream); }
	.dek { margin: 0 0 2rem; color: var(--body-on-plum); }
	form { display: flex; flex-direction: column; gap: 26px; }
	.row { display: flex; flex-direction: column; gap: 0.4rem; }
	.row-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; }
	label, legend {
		padding: 0;
		color: var(--label-on-plum);
		font-family: 'Courier New', Cousine, monospace;
		font-size: 11px;
		font-weight: normal;
		text-transform: uppercase;
		letter-spacing: 0.16em;
	}
	.opt { font-weight: normal; opacity: 0.65; color: var(--label-on-plum); }
	input[type='email'],
	input[type='text'] {
		width: 100%;
		padding: 9px 0;
		font: inherit;
		font-size: 1rem;
		color: var(--cream);
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--hairline-on-plum);
	}
	textarea {
		width: 100%;
		padding: 12px;
		font: inherit;
		font-size: 1rem;
		color: var(--cream);
		background: rgba(250, 246, 239, 0.06);
		border: 1px solid rgba(250, 246, 239, 0.3);
		resize: vertical;
		line-height: 1.5;
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: none;
		outline-offset: 1px;
		border-color: var(--mustard);
	}
	fieldset { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
	.radio {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr);
		gap: 14px;
		align-items: start;
		font-weight: normal;
		line-height: 1.45;
		cursor: pointer;
		padding: 14px 0;
		color: var(--body-on-plum);
		border-top: 1px solid var(--hairline-on-plum);
	}
	.radio input { margin-top: 5px; accent-color: var(--mustard); }
	button {
		align-self: flex-start;
		font-family: 'Courier New', Cousine, monospace;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--plum);
		background: var(--mustard);
		border: none;
		padding: 16px 30px;
		cursor: pointer;
	}
	button:hover { background: var(--cream); }
	button:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }
	.hp { position: absolute; left: -9999px; }
</style>
