---
// The one nav for the whole site — main pages and Four Laws pages alike.
//
// Four Laws used to have its own separate, grouped Explore/Tools/Reference
// nav (FourLawsNav.astro, now deleted) carrying all thirteen content pages
// and three tools in the page header itself. On a phone that was a screen
// and a half of links before any actual content, and its big serif
// "Four Laws of Complex System Design" wordmark linked to this site's
// homepage — a jarring mismatch, since that page is about Jon's consulting,
// not Four Laws. Confusing on both counts.
//
// Fixed by going the other direction: one slim nav everywhere, and the full
// Four Laws link list moved to FourLawsFooter.astro — still fully reachable
// on every Four Laws page, just after the content instead of blocking it.
//
// `section="four-laws"` (passed only by FourLawsLayout.astro) highlights the
// "Four Laws of Complex System Design" link as the current section even
// though it points at one specific page (the Full Reference) rather than
// whichever Four Laws page you're actually on — same "current section, not
// literally current page" treatment "Writing" already gets below.
interface Props {
	section?: 'four-laws';
}
const { section } = Astro.props;

const links: { href: string; text: string }[] = [
	{ href: '/writing', text: 'Writing' },
	{ href: '/about', text: 'About' },
];

// build.format 'file' (astro.config.mjs) means Astro.url.pathname here is
// e.g. '/writing.html' — strip it, or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

// Writing needs prefix matching because individual posts live beneath it and
// should still mark the section as current. About is a single page, so an exact
// match is correct — and prefix-matching a one-page section is how you end up
// highlighting it on /about-something-else later.
const isCurrent = (href: string) => {
	if (href === '/writing') return path === '/writing' || path.startsWith('/writing/');
	return path === href;
};
---

<a class="skip" href="#main">Skip to content</a>

<header>
	<nav aria-label="Primary">
		<div class="masthead">
			<a class="wordmark" href="/">Jon Martin</a>
			<div class="links">
				{links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.text}
					</a>
				))}
				<a
					class="crosssite"
					href="/four-laws-complex-system-design-full"
					aria-current={section === 'four-laws' ? 'page' : undefined}
				>
					Four Laws of Complex System Design
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	/* Visible only when tabbed to — keyboard users get the escape hatch without
	   it occupying layout for everyone else. */
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--cream);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--plum);
	}

	header {
		border-bottom: 1px solid var(--hairline);
	}
	nav {
		max-width: 680px;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}

	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.wordmark {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.15rem;
		color: var(--plum);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
	}
	.links a {
		font-size: 0.95rem;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.links a:hover {
		border-bottom-color: var(--plum);
	}
	/* Mustard's single appearance in the chrome: it marks where you are, which
	   is a genuine outlier among a list of places you aren't. */
	.links a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	/* A different kind of destination than "Writing" — the whole Four Laws
	   reference, not another page in the same register — so it's set apart
	   with a hairline rule rather than folded into the same unbroken list. */
	.crosssite {
		padding-left: 1.5rem;
		border-left: 1px solid var(--hairline);
		color: var(--sage);
	}
	.crosssite:hover {
		border-bottom-color: var(--sage);
	}
	.crosssite[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}
</style>
