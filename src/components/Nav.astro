---
import Wordmark from './Wordmark.astro';
import { fourLawsGroups } from '../lib/four-laws-links';

// The one nav for the whole site. Rebuilt to the brand/visual-system design
// handoff's header spec: wordmark + "Jon Martin" on the left, Writing / About
// / Four Laws / Waitlist on the right, Courier New uppercase, reserved-space
// hover underline.
//
// "Four Laws of Complex System Design" stays a dropdown (native <details>/
// <summary>, restyled to the new tokens) rather than the handoff's flat link
// to the old pre-consolidation fourlaws.thejonmartin.com — the handoff
// predates both the site consolidation and the dropdown shipped immediately
// before this redesign work started, and reverting to a flat link would be a
// straight regression from something just explicitly requested. See
// src/lib/four-laws-links.ts (shared with FourLawsFooter.astro's repeat of
// the same list).
//
// "About" points at the real /about page — the handoff's own nav uses
// `#about`, an in-page anchor, because its prototype file has no other pages
// to link to. "Waitlist" points at /#notify — the handoff calls this anchor
// `#waitlist`, but the live site's existing waitlist section
// (NotifyForm.astro) is `id="notify"` already, linked from several other
// places, so the nav link was adapted to match the existing id rather than
// renaming the id everywhere to match a design mockup's placeholder name.
//
// `bordered` — false only on the homepage, where the plum hero band directly
// below the header supplies its own visual edge; every other page keeps the
// hairline. `section="four-laws"` (passed only by FourLawsLayout.astro)
// highlights the Four Laws summary as the current section.
interface Props {
	section?: 'four-laws';
	bordered?: boolean;
}
const { section, bordered = true } = Astro.props;

const links: { href: string; text: string }[] = [
	{ href: '/writing', text: 'Writing' },
	{ href: '/about', text: 'About' },
];

// build.format 'file' (astro.config.mjs) means Astro.url.pathname here is
// e.g. '/writing.html' — strip it, or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

// Writing needs prefix matching because individual posts live beneath it and
// should still mark the section as current. About is a single page, so an
// exact match is correct.
const isCurrent = (href: string) => {
	if (href === '/writing') return path === '/writing' || path.startsWith('/writing/');
	return path === href;
};
---

<a class="skip" href="#main">Skip to content</a>

<header class:list={{ bordered }}>
	<nav aria-label="Primary">
		<div class="masthead">
			<a class="wordmark" href="/">
				<Wordmark size={26} />
				<span>Jon Martin</span>
			</a>
			<div class="links">
				{links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.text}
					</a>
				))}
				<details class="four-laws">
					<summary aria-current={section === 'four-laws' ? 'page' : undefined}>
						Four Laws
					</summary>
					<div class="panel">
						{fourLawsGroups.map((group) => (
							<div class="group">
								<span class="label group-label">{group.label}</span>
								<ul>
									{group.links.map((link) => (
										<li>
											<a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
												{link.text}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</details>
				<a class="waitlist" href="/#notify">Waitlist</a>
			</div>
		</div>
	</nav>
</header>

<style>
	/* Visible only when tabbed to — keyboard users get the escape hatch without
	   it occupying layout for everyone else. */
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--cream);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--plum);
	}

	header {
		z-index: 5;
	}
	header.bordered {
		border-bottom: 1px solid var(--hairline);
	}
	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 22px 40px;
		position: relative;
	}

	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 24px;
	}
	.wordmark {
		display: flex;
		align-items: center;
		gap: 14px;
		font-family: Georgia, Gelasio, serif;
		font-size: 21px;
		color: var(--plum);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 22px;
	}
	.links > a,
	summary {
		font-family: 'Courier New', Cousine, monospace;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--plum);
		text-decoration: none;
		padding-bottom: 3px;
		border-bottom: 1px solid transparent;
	}
	.links > a:hover,
	summary:hover {
		border-bottom-color: var(--mustard);
	}
	/* Mustard's single small-scale appearance in the chrome: it marks where
	   you are, a genuine outlier among a list of places you aren't. */
	.links > a[aria-current='page'],
	summary[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}
	.waitlist {
		color: var(--sage);
		border-bottom-color: var(--sage);
	}
	.waitlist:hover {
		color: var(--plum);
		border-bottom-color: var(--mustard);
	}

	.four-laws {
		position: static;
	}
	summary {
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: '▾';
		display: inline-block;
		margin-left: 0.35em;
		font-size: 0.9em;
		transition: transform 0.15s ease;
	}
	details[open] summary::after {
		transform: rotate(180deg);
	}

	.panel {
		position: absolute;
		top: calc(100% + 0.75rem);
		right: 40px;
		width: min(calc(100vw - 3rem), 30rem);
		background: var(--cream);
		border: 1px solid var(--hairline);
		padding: 1.25rem;
		box-shadow: 0 4px 16px rgba(46, 42, 38, 0.12);
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		z-index: 20;
	}
	.group-label {
		font-size: 11px;
		color: var(--muted);
		display: block;
		margin-bottom: 0.5rem;
	}
	.panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.panel li a {
		font-family: Calibri, Carlito, Lato, sans-serif;
		font-size: 0.9rem;
		text-transform: none;
		letter-spacing: normal;
		color: var(--charcoal);
		border-bottom: 1px solid transparent;
		padding-bottom: 1px;
	}
	.panel li a:hover {
		border-bottom-color: var(--plum);
	}
	.panel li a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	@media (max-width: 720px) {
		nav {
			padding: 16px 20px;
		}
		/* Keeps the panel's right edge aligned with the trigger at the
		   reduced mobile padding above — without this it stays anchored to
		   the desktop 40px value while nav's own content sits 20px in,
		   leaving a visible gap between the trigger and the panel below it. */
		.panel {
			right: 20px;
		}
	}
</style>
