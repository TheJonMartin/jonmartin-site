---
import Wordmark from './Wordmark.astro';
import { fourLawsGroups } from '../lib/four-laws-links';
import { altitudeGroups } from '../lib/altitude-links';

// Site nav: wordmark + Writing (dropdown) / Tools / About / Audit & Fixer (dropdown).
// Writing is a <details> dropdown with three sections: All writing, Four Laws, Altitude
// (shared link lists in four-laws-links / altitude-links).
interface Props {
	section?: 'four-laws' | 'altitude';
	/** False on homepage — plum hero supplies the edge. */
	bordered?: boolean;
}
const { section, bordered = true } = Astro.props;

const links: { href: string; text: string }[] = [
	{ href: '/tools', text: 'Tools' },
	{ href: '/about', text: 'About' },
];

const writingSections = [
	{ key: 'four-laws', label: 'The Four Laws', groups: fourLawsGroups },
	{ key: 'altitude', label: 'Requirements Altitude', groups: altitudeGroups },
];
// Portal Audit and Fixer live on their own subdomains (separate apps), so these are plain external links.
const appLinks: { href: string; text: string; note: string }[] = [
	{ href: 'https://audit.thejonmartin.com', text: 'Health Audit', note: 'A read-only check of your HubSpot portal.' },
	{ href: 'https://fix.thejonmartin.com', text: 'Fixer', note: 'Paid plans that fix what the audit finds.' },
];

// build.format 'file' → pathname may be '/writing.html'; strip or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

// Writing dropdown is current on essays, Four Laws pages and Altitude pages.
const inWriting =
	section !== undefined ||
	path === '/writing' ||
	path.startsWith('/writing/') ||
	path === '/altitude' ||
	path.startsWith('/altitude/');

// Writing: prefix match so posts mark the section current. Others: exact.
const isCurrent = (href: string) => {
	if (href === '/writing') return path === '/writing' || path.startsWith('/writing/');
	if (href === '/tools') return path === '/tools' || path.startsWith('/tools/');
	return path === href;
};
---

<a class="skip" href="#main">Skip to content</a>

<header class:list={{ bordered }}>
	<nav aria-label="Primary">
		<div class="masthead">
			<a class="wordmark" href="/">
				<Wordmark size={26} decorative />
				<span>Jon Martin</span>
			</a>
			<div class="links">
				<details class="menu writing">
					<summary aria-current={inWriting ? 'page' : undefined}>Writing</summary>
					<div class="panel wide">
						<div class="section">
							<a class="all" href="/writing" aria-current={path === '/writing' ? 'page' : undefined}>All writing →</a>
						</div>
						{writingSections.map((sec) => (
							<div class="section">
								<span class="label section-label">{sec.label}</span>
								<div class="groups">
									{sec.groups.map((group) => (
										<div class="group">
											<span class="label group-label">{group.label}</span>
											<ul>
												{group.links.map((link) => (
													<li>
														<a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
															{link.text}
														</a>
													</li>
												))}
											</ul>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				</details>
				{links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.text}
					</a>
				))}
				<details class="menu apps">
					<summary>Audit &amp; Fixer</summary>
					<div class="panel narrow">
						<ul>
							{appLinks.map((link) => (
								<li>
									<a href={link.href}>{link.text}</a>
									<span class="note">{link.note}</span>
								</li>
							))}
						</ul>
					</div>
				</details>
			</div>
		</div>
	</nav>
</header>

<style>
	/* Skip link: off-screen until focused. */
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--cream);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--plum);
	}

	header {
		z-index: 5;
	}
	header.bordered {
		border-bottom: 1px solid var(--hairline);
	}
	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 22px 40px;
		position: relative;
	}

	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 24px;
	}
	.wordmark {
		display: flex;
		align-items: center;
		gap: 14px;
		font-family: Georgia, Gelasio, serif;
		font-size: 21px;
		color: var(--plum);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 22px;
	}
	.links > a,
	summary {
		font-family: 'Courier New', Cousine, monospace;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--plum);
		text-decoration: none;
		padding-bottom: 3px;
		border-bottom: 1px solid transparent;
	}
	.links > a:hover,
	summary:hover {
		border-bottom-color: var(--mustard);
	}
	/* Mustard marks current page only. */
	.links > a[aria-current='page'],
	summary[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}
	.menu {
		position: static;
	}
	summary {
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: '▾';
		display: inline-block;
		margin-left: 0.35em;
		font-size: 0.9em;
		transition: transform 0.15s ease;
	}
	details[open] summary::after {
		transform: rotate(180deg);
	}

	.panel {
		position: absolute;
		top: calc(100% + 0.75rem);
		right: 40px;
		width: min(calc(100vw - 3rem), 30rem);
		background: var(--cream);
		border: 1px solid var(--hairline);
		padding: 1.25rem;
		box-shadow: 0 4px 16px rgba(46, 42, 38, 0.12);
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		z-index: 20;
	}
	.panel.wide {
		width: min(calc(100vw - 3rem), 52rem);
		flex-direction: column;
		gap: 1.25rem;
		max-height: calc(100vh - 8rem);
		overflow-y: auto;
	}
	.section-label {
		font-size: 12px;
		color: var(--plum);
		display: block;
		margin-bottom: 0.6rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--hairline);
	}
	.groups {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2rem;
	}
	.section .all {
		font-family: 'Courier New', Cousine, monospace;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--plum);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.section .all:hover,
	.section .all[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}
	.panel.narrow {
		width: min(calc(100vw - 3rem), 18rem);
	}
	.panel li .note {
		display: block;
		font-family: Calibri, Carlito, Lato, sans-serif;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--muted);
		margin-top: 0.15rem;
	}
	.group-label {
		font-size: 11px;
		color: var(--muted);
		display: block;
		margin-bottom: 0.5rem;
	}
	.panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.panel li a {
		font-family: Calibri, Carlito, Lato, sans-serif;
		font-size: 0.9rem;
		text-transform: none;
		letter-spacing: normal;
		color: var(--charcoal);
		border-bottom: 1px solid transparent;
		padding-bottom: 1px;
	}
	.panel li a:hover {
		border-bottom-color: var(--plum);
	}
	.panel li a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	@media (max-width: 720px) {
		nav {
			padding: 16px 20px;
		}
		/* Match panel right edge to mobile nav padding (20px). */
		.panel {
			right: 20px;
		}
	}
</style>
