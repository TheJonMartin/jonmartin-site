---
// Main-page nav: home, writing, about. Four Laws' own content (thirteen
// pages, three tools) has a separate, grouped nav — see FourLawsNav.astro —
// used only on those pages, since a flat single row doesn't scale to that
// much material. Structure and class names still mirror FourLawsNav.astro
// (skip link, hairline header, wordmark) so the two read as one family
// rather than two unrelated designs, even though only one of them appears on
// any given page.
//
// The link to Four Laws goes to the Full Reference — the natural deep-dive
// entry point into that material (same page the About page's "Where the
// framework comes from" section links to). It's visually set apart with a
// hairline rule because it's a different kind of destination than "Writing"
// — a deep reference document, not another page in the same register.
const links: { href: string; text: string }[] = [
	{ href: '/writing', text: 'Writing' },
	{ href: '/about', text: 'About' },
];

// build.format 'file' (astro.config.mjs) means Astro.url.pathname here is
// e.g. '/writing.html' — strip it the same way FourLawsNav.astro and
// Base.astro's canonical logic do, or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

// Writing needs prefix matching because individual posts live beneath it and
// should still mark the section as current. About is a single page, so an exact
// match is correct — and prefix-matching a one-page section is how you end up
// highlighting it on /about-something-else later.
const isCurrent = (href: string) => {
	if (href === '/writing') return path === '/writing' || path.startsWith('/writing/');
	return path === href;
};
---

<a class="skip" href="#main">Skip to content</a>

<header>
	<nav aria-label="Primary">
		<div class="masthead">
			<a class="wordmark" href="/">Jon Martin</a>
			<div class="links">
				{links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.text}
					</a>
				))}
				<a class="crosssite" href="/four-laws-complex-system-design-full">
					Four Laws of Complex System Design
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	/* Visible only when tabbed to — keyboard users get the escape hatch without
	   it occupying layout for everyone else. */
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--cream);
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--plum);
	}

	header {
		border-bottom: 1px solid var(--hairline);
	}
	nav {
		max-width: 680px;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}

	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.wordmark {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.15rem;
		color: var(--plum);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
	}
	.links a {
		font-size: 0.95rem;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.links a:hover {
		border-bottom-color: var(--plum);
	}
	/* Mustard's single appearance in the chrome: it marks where you are, which
	   is a genuine outlier among a list of places you aren't. */
	.links a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	/* A different kind of destination than "Writing" — a deep reference
	   document with its own grouped nav on the far side of it, not another
	   page in the same register — so it's set apart with a hairline rule
	   rather than folded into the same unbroken list. */
	.crosssite {
		padding-left: 1.5rem;
		border-left: 1px solid var(--hairline);
		color: var(--sage);
	}
	.crosssite:hover {
		border-bottom-color: var(--sage);
	}
</style>
