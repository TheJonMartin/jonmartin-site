---
// Netlify Forms capture for general consulting inquiries, linked from the
// About page. Distinct from NotifyForm.astro's "waitlist" (a pre-launch
// research signup with no reply promised) — this one is a real "get in
// touch about work" form, closer in shape to Four Laws' own contact.astro.
//
// Netlify detects forms from the built HTML at deploy time. Two
// requirements for that to keep working:
//   1. Forms must stay ENABLED on the Netlify project (jonmartin-mvp).
//   2. The hidden form-name input below must match the form's name attribute.
//
// Named "consulting-inquiry" — distinct from "waitlist" and
// "fourlaws-contact" so submissions land in their own bucket in the
// Netlify dashboard rather than mixing with either.
//
// Submissions land in Netlify → jonmartin-mvp → Forms → consulting-inquiry.
---

<form
	name="consulting-inquiry"
	method="POST"
	action="/thanks-consulting"
	data-netlify="true"
	netlify-honeypot="bot-field"
>
	<input type="hidden" name="form-name" value="consulting-inquiry" />
	<p class="hp">
		<label>Leave this empty if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<div class="row">
		<label for="ci-name">Name</label>
		<input type="text" id="ci-name" name="name" required autocomplete="name" />
	</div>

	<div class="row">
		<label for="ci-email">Email</label>
		<input type="email" id="ci-email" name="email" required autocomplete="email" placeholder="you@company.com" />
	</div>

	<div class="row">
		<label for="ci-company">Company <span class="opt">(optional)</span></label>
		<input type="text" id="ci-company" name="company" autocomplete="organization" />
	</div>

	<div class="row">
		<label for="ci-message">What's going on?</label>
		<textarea id="ci-message" name="message" rows="5" required
			placeholder="What's breaking, what you've already tried, or what a second opinion would need to cover."></textarea>
	</div>

	<button type="submit">Send &rarr;</button>
</form>

<style>
	form { display: flex; flex-direction: column; gap: 1.5rem; }
	.row { display: flex; flex-direction: column; gap: 0.4rem; }
	label { font-size: 0.95rem; font-weight: bold; color: var(--charcoal); }
	.opt { font-weight: normal; opacity: 0.65; }
	input[type='text'],
	input[type='email'],
	textarea {
		width: 100%;
		padding: 0.6rem 0.7rem;
		font: inherit;
		font-size: 1rem;
		color: var(--charcoal);
		background: #fffdf9;
		border: 1px solid rgba(46, 42, 38, 0.3);
		border-radius: 2px;
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--plum);
		outline-offset: 1px;
		border-color: var(--plum);
	}
	textarea { resize: vertical; line-height: 1.5; }
	button {
		align-self: flex-start;
		font: inherit;
		font-size: 1rem;
		color: var(--cream);
		background: var(--plum);
		border: none;
		border-radius: 2px;
		padding: 0.7rem 1.5rem;
		cursor: pointer;
	}
	button:hover { background: #3c2a43; }
	button:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }
	/* Off-screen rather than display:none — some bots skip hidden fields,
	   which defeats the point of having one. */
	.hp { position: absolute; left: -9999px; }
</style>
