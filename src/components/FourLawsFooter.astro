---
// "Written by Jon Martin" now links to /about rather than the site root —
// from the two-site era, this used to be the cross-domain jump back to
// thejonmartin.com; now it's the same site, so a bare link to "/" would be a
// no-op. /about is the more useful destination a reader who wants to know
// who wrote this would actually want.
//
// The sign-off matches the main site's exactly. A longer rights notice used
// to trail this line and nothing on thejonmartin.com — two different
// copyright notices across one brand read as two different operations.
//
// Keep notes like this in the frontmatter, not in an HTML comment: Astro emits
// HTML comments to the built page, so a comment explaining why a phrase was
// removed will ship that phrase right back into the markup.
const year = new Date().getFullYear();
---

<footer>
	<hr class="hairline" />
	<div class="inner">
		<p class="colophon">
			Four Laws of Complex System Design &copy; {year} Jon Martin.
		</p>
		<p class="crosslink">
			Written by <a href="/about">Jon Martin</a>.
		</p>
	</div>
</footer>

<style>
	.inner {
		max-width: 68rem;
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: space-between;
	}
	p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
	}
</style>
