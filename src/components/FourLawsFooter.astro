---
import Wordmark from './Wordmark.astro';
import { fourLawsGroups } from '../lib/four-laws-links';

// The full Explore/Tools/Reference link list is also reachable from every
// page via the "Four Laws of Complex System Design" dropdown in Nav.astro
// (both read from the same src/lib/four-laws-links.ts). Repeated here as a
// plain, always-visible sitemap at the bottom of every Four Laws page too —
// standard practice, and useful for anyone who'd rather scan a full list
// than open a menu.
//
// build.format 'file' means Astro.url.pathname is e.g. '/glossary.html' —
// strip it, same as Nav.astro, or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

// "Written by Jon Martin" links to /about rather than the site root — from
// the two-site era, this used to be the cross-domain jump back to
// thejonmartin.com; now it's the same site, so a bare link to "/" would be a
// no-op. /about is the more useful destination a reader who wants to know
// who wrote this would actually want.
//
// The sign-off matches the main site's exactly. A longer rights notice used
// to trail this line and nothing on thejonmartin.com — two different
// copyright notices across one brand read as two different operations.
const year = new Date().getFullYear();
---

<footer>
	<hr class="hairline" />
	<div class="inner">
		<nav aria-label="Four Laws sections">
			{fourLawsGroups.map((group) => (
				<div class="group">
					<span class="label group-label">{group.label}</span>
					<ul>
						{group.links.map((link) => (
							<li>
								<a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
									{link.text}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</nav>

		<hr class="hairline" />

		<div class="colophon-row">
			<div class="brand">
				<Wordmark size={18} />
				<p class="colophon">
					Four Laws of Complex System Design &copy; {year} Jon Martin.
				</p>
			</div>
			<p class="crosslink">
				Written by <a href="/about">Jon Martin</a>.
			</p>
		</div>
	</div>
</footer>

<style>
	.inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 40px 1.5rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
	}
	.group-label {
		font-size: 0.72rem;
		color: var(--muted);
		display: block;
		margin-bottom: 0.35rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	li a {
		font-size: 0.9rem;
		color: var(--charcoal);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	li a:hover {
		border-bottom-color: var(--plum);
	}
	/* Mustard's single appearance in this block: it marks where you are,
	   which is a genuine outlier among a list of places you aren't. */
	li a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	.inner hr.hairline {
		margin: 1.5rem 0;
	}

	.colophon-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.colophon-row p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.inner { padding: 2rem 20px 1.5rem; }
	}
</style>
