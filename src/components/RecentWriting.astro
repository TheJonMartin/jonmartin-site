---
import { getCollection } from 'astro:content';

// Three most recent published posts, for the homepage. Renders nothing at all
// when there's nothing published — an empty "Writing" heading on the homepage
// looks worse than no section.
const posts = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

{
	posts.length > 0 && (
		<section class="writing">
			<p class="label kicker">Writing</p>
			<ul>
				{posts.map((post) => (
					<li>
						<p class="label date">{fmt(post.data.pubDate)}</p>
						<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
						<p class="desc">{post.data.description}</p>
					</li>
				))}
			</ul>
			<p class="all"><a href="/writing/">All writing &rarr;</a></p>
		</section>
	)
}

<style>
	.writing { padding: 3rem 0; }
	.kicker { font-size: 0.8rem; color: var(--sage); margin: 0 0 1.5rem; }
	ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2rem; }
	.date { font-size: 0.8rem; color: var(--sage); margin: 0 0 0.3rem; }
	h2 { font-size: 1.2rem; margin: 0 0 0.4rem; }
	h2 a { text-decoration: none; border-bottom: 1px solid rgba(74, 51, 82, 0.3); }
	h2 a:hover { border-bottom-color: var(--plum); }
	.desc { margin: 0; }
	.all { margin: 2rem 0 0; }
	.all a { font-family: 'Courier New', Courier, monospace; font-size: 0.9rem; text-decoration: none; border-bottom: 1px solid var(--plum); }
</style>
