---
import type { PseoRelated } from '../../lib/pseo';

interface Props {
	related: PseoRelated[];
}
const { related } = Astro.props;
---

{related.length > 0 && (
	<section class="related" aria-labelledby="related-comparisons">
		<div class="inner ledger">
			<div class="rail">
				<h2 id="related-comparisons" class="label">Related comparisons</h2>
				<div class="rule"></div>
			</div>
			<ul class="rel-list">
				{related.map((r) => (
					<li>
						<a class="rel-title" href={r.href}>{r.title} &rarr;</a>
						{r.dek && <p class="rel-dek">{r.dek}</p>}
					</li>
				))}
			</ul>
		</div>
	</section>
)}

<style>
	.related { padding: 64px 0; border-top: 1px solid var(--hairline); }
	.inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
	.ledger { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.6fr); gap: 56px; }
	.label { font-family: 'Courier New', Cousine, monospace; font-size: 12px; font-weight: 400; line-height: 1.4; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sage); margin: 0 0 0.75rem; }
	.rule { width: 40px; height: 2px; background: var(--mustard); }
	.rel-list { list-style: none; margin: 0; padding: 0; max-width: 66ch; }
	.rel-list li { padding: 16px 0; border-top: 1px solid var(--hairline); }
	.rel-list li:first-child { border-top: none; padding-top: 0; }
	.rel-title { font-family: Georgia, Gelasio, serif; font-size: 22px; line-height: 1.3; color: var(--plum); text-decoration: underline; text-decoration-color: var(--mustard); text-decoration-thickness: 2px; text-underline-offset: 5px; }
	.rel-title:hover { color: var(--charcoal); }
	.rel-dek { font-size: 17px; line-height: 1.55; margin: 0.5rem 0 0; }

	@media (max-width: 720px) {
		.inner { padding: 0 20px; }
		.related { padding: 48px 0; }
		.ledger { grid-template-columns: 1fr; gap: 20px; }
	}
</style>
