---
// Brand mark — exception to Field & Ledger "no iconography": plum + mustard rects as abstract range gauge.
interface Props {
	size?: number;
	/** Hide the mark from AT when the same control already has a visible name. */
	decorative?: boolean;
}
const { size = 26, decorative = false } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 26 26"
	xmlns="http://www.w3.org/2000/svg"
	role={decorative ? undefined : 'img'}
	aria-label={decorative ? undefined : 'Jon Martin'}
	aria-hidden={decorative ? 'true' : undefined}
>
	<rect x="0" y="2" width="6" height="22" fill="#4A3352" />
	<rect x="9" y="14" width="17" height="6" fill="#E8A93B" />
</svg>
