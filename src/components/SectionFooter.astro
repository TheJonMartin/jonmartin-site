---
import Wordmark from './Wordmark.astro';

interface Link {
	href: string;
	text: string;
}
interface Group {
	label: string;
	links: Link[];
}
interface Props {
	groups: Group[];
	label: string;
	/** Raw HTML for the colophon line (allows &copy; vs © per section). */
	colophon: string;
}

const { groups, label, colophon } = Astro.props;

// build.format 'file' means Astro.url.pathname is e.g. '/glossary.html' —
// strip it, same as Nav.astro, or aria-current never matches.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<footer>
	<hr class="hairline" />
	<div class="inner">
		<nav aria-label={label}>
			{groups.map((group) => (
				<div class="group">
					<span class="label group-label">{group.label}</span>
					<ul>
						{group.links.map((link) => (
							<li>
								<a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
									{link.text}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</nav>

		<hr class="hairline" />

		<div class="colophon-row">
			<div class="brand">
				<Wordmark size={18} />
				<p class="colophon" set:html={colophon} />
			</div>
			<p class="crosslink">
				<slot />
			</p>
		</div>
	</div>
</footer>

<style>
	.inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 40px 1.5rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
	}
	.group-label {
		font-size: 0.72rem;
		color: var(--muted);
		display: block;
		margin-bottom: 0.35rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	li a {
		font-size: 0.9rem;
		color: var(--charcoal);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	li a:hover {
		border-bottom-color: var(--plum);
	}
	li a[aria-current='page'] {
		border-bottom-color: var(--mustard);
	}

	.inner hr.hairline {
		margin: 1.5rem 0;
	}

	.colophon-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.colophon-row p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.inner { padding: 2rem 20px 1.5rem; }
	}
</style>
