---
import Nav from '../components/Nav.astro';
import SectionFooter from '../components/SectionFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import { GA_MAIN } from '../../shared/analytics';
import { breadcrumbSchema } from '../lib/schema';
import { altitudeGroups } from '../lib/altitude-links';
import '../../shared/styles/field-and-ledger.css';
import '../../shared/styles/section-reading.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	seoTitle?: string;
	ogImage?: string;
	ogType?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
	title,
	description,
	noindex = false,
	seoTitle,
	ogImage = '/og.png',
	ogType = 'article',
	schema,
} = Astro.props;

const cleanPath = Astro.url.pathname
	.replace(/index\.html$/, '')
	.replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, '');

const siteName = 'Requirements Altitude';
const fullTitle = seoTitle ?? (title.startsWith(siteName) ? title : `${title} | ${siteName}`);

const isHub = cleanPath === '/altitude';
const altitudeHubUrl = new URL('/altitude', Astro.site).href.replace(/\/$/, '');
const breadcrumb = isHub
	? breadcrumbSchema(title, canonical, Astro.site!.href)
	: breadcrumbSchema(title, canonical, Astro.site!.href, {
			name: 'Requirements Altitude',
			url: altitudeHubUrl,
		});
const schemaList = [
	breadcrumb,
	...(Array.isArray(schema) ? schema : schema ? [schema] : []),
].filter((s): s is Record<string, unknown> => Boolean(s));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<SeoHead
			title={fullTitle}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogType={ogType}
			siteName={siteName}
			schema={schemaList}
			noindex={noindex}
			analyticsId={GA_MAIN}
		/>
	</head>
	<body>
		<Nav section="altitude" />
		<main id="main">
			<slot />
		</main>
		<SectionFooter
			groups={altitudeGroups}
			label="Requirements Altitude sections"
			colophon={`Requirements Altitude © ${year} Jon Martin.`}
		>
			Written by <a href="/about">Jon Martin</a>. Companion framework: <a href="/four-laws-complex-system-design-full">Four Laws</a>.
		</SectionFooter>
	</body>
</html>

<style is:global>
	/* Altitude-only extras on top of shared/styles/section-reading.css */
	main pre {
		overflow-x: auto;
		padding: 1rem 1.1rem;
		border: 1px solid var(--hairline);
		background: rgba(74, 51, 82, 0.04);
		font-family: 'Courier New', Cousine, monospace;
		font-size: 0.88rem;
		line-height: 1.45;
	}
	main table { width: 100%; border-collapse: collapse; font-size: 0.92rem; margin: 1.25rem 0 1.75rem; }
	main th, main td {
		text-align: left;
		vertical-align: top;
		padding: 0.45rem 0.6rem 0.45rem 0;
		border-bottom: 1px solid var(--hairline);
	}
	main th {
		font-family: 'Courier New', Cousine, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		font-weight: normal;
	}
</style>
