---
interface Props {
	title: string;
	description: string;
	/** Set on utility pages (e.g. /thanks) that shouldn't appear in search. */
	noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

// Field & Ledger tokens and base element styles. Shared verbatim with the Four
// Laws site (src-fourlaws/layouts/Base.astro) so the two can't drift — edit
// shared/styles/field-and-ledger.css, not a copy in here.
import '../../shared/styles/field-and-ledger.css';

// Requires `site` to be set in astro.config.mjs — without it Astro.site is
// undefined and this throws at build time rather than silently emitting a
// broken canonical.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<slot />
	</body>
</html>

