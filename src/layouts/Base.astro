---
interface Props {
	title: string;
	description: string;
	/** Utility pages (e.g. /thanks) that shouldn't appear in search. */
	noindex?: boolean;
	/** Full <title>/og:title when the on-page h1 is too long for SERP display. */
	seoTitle?: string;
	/** Root-relative social card. Defaults to /og.png. */
	ogImage?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
	/** og:type. /writing posts pass 'article'. */
	ogType?: string;
	/** ISO dates for article:* times; only emitted when ogType is 'article'. */
	publishedTime?: string;
	modifiedTime?: string;
	/** False on the homepage — plum hero supplies the edge; header hairline would double it. */
	navBordered?: boolean;
}
const {
	title,
	description,
	noindex = false,
	seoTitle,
	ogImage = '/og.png',
	schema,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	navBordered = true,
} = Astro.props;

import '../../shared/styles/field-and-ledger.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { GA_MAIN } from '../../shared/analytics';

// build.format 'file' → pathname is e.g. '/about.html'; strip so canonical matches the served URL.
const cleanPath = Astro.url.pathname
	.replace(/index\.html$/, '')
	.replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, '');

const headTitle = seoTitle ?? title;
---
<!doctype html>
<html lang="en">
	<head>
		<SeoHead
			title={headTitle}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogType={ogType}
			siteName="Jon Martin"
			schema={schema}
			noindex={noindex}
			analyticsId={GA_MAIN}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			rss={{ title: 'Jon Martin — Writing', href: new URL('/rss.xml', Astro.site).href }}
		/>
	</head>
	<body>
		<Nav bordered={navBordered} />
		<slot />
		<Footer />
	</body>
</html>
