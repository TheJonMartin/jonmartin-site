---
interface Props {
	title: string;
	description: string;
	/** Set on utility pages (e.g. /thanks) that shouldn't appear in search. */
	noindex?: boolean;
	/**
	 * Overrides the <title> and og:title without touching the on-page <h1>.
	 * Use it when the headline that reads well on the page runs past the ~60
	 * characters Google will actually display. Falls back to `title`.
	 */
	seoTitle?: string;
	/**
	 * Per-page social card, as a site-root-relative path (e.g. '/og-writing.png').
	 * Defaults to the site-wide card in public/og.png.
	 */
	ogImage?: string;
	/**
	 * JSON-LD to emit in <head>. Pass a plain object; it's serialized here.
	 * See src/pages/index.astro for the Person + WebSite example.
	 */
	schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
	title,
	description,
	noindex = false,
	seoTitle,
	ogImage = '/og.png',
	schema,
} = Astro.props;

// Field & Ledger tokens and base element styles. Shared verbatim with the Four
// Laws site (src-fourlaws/layouts/Base.astro) so the two can't drift — edit
// shared/styles/field-and-ledger.css, not a copy in here.
import '../../shared/styles/field-and-ledger.css';
import Nav from '../components/Nav.astro';
import Analytics from '../components/Analytics.astro';
import { GA_MAIN } from '../../shared/analytics';

// Requires `site` to be set in astro.config.mjs — without it Astro.site is
// undefined and this throws at build time rather than silently emitting a
// broken canonical.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// og:image must be an absolute URL. Relative paths are silently dropped by
// most scrapers rather than resolved, which is the failure mode that leaves
// you wondering why the card is blank.
const ogImageUrl = new URL(ogImage, Astro.site).href;

const headTitle = seoTitle ?? title;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{headTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#4A3352" />

		<link
			rel="alternate"
			type="application/rss+xml"
			title="Jon Martin — Writing"
			href={new URL('/rss.xml', Astro.site).href}
		/>

		<meta property="og:site_name" content="Jon Martin" />
		<meta property="og:title" content={headTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImageUrl} />

		{schema && (
			<script
				type="application/ld+json"
				is:inline
				set:html={JSON.stringify(schema)}
			/>
		)}

		<Analytics id={GA_MAIN} />
	</head>
	<body>
		<Nav />
		<slot />
	</body>
</html>
