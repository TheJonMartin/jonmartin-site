---
interface Props {
	title: string;
	description: string;
	/** Set on utility pages (e.g. /thanks) that shouldn't appear in search. */
	noindex?: boolean;
	/**
	 * Overrides the <title> and og:title without touching the on-page <h1>.
	 * Use it when the headline that reads well on the page runs past the ~60
	 * characters Google will actually display. Falls back to `title`.
	 */
	seoTitle?: string;
	/**
	 * Per-page social card, as a site-root-relative path (e.g. '/og-writing.png').
	 * Defaults to the site-wide card in public/og.png.
	 */
	ogImage?: string;
	/**
	 * JSON-LD to emit in <head>. Pass a plain object; it's serialized here.
	 * See src/pages/index.astro for the Person + WebSite example.
	 */
	schema?: Record<string, unknown> | Record<string, unknown>[];
	/** og:type. 'website' by default; /writing posts pass 'article'. */
	ogType?: string;
	/** ISO dates for article:published_time / article:modified_time. Only
	 * emitted when ogType is 'article'. */
	publishedTime?: string;
	modifiedTime?: string;
	/** False only on the homepage — the plum hero band directly below the
	 * header supplies its own visual edge there, so the header's own hairline
	 * would be a redundant second line right above it. */
	navBordered?: boolean;
}
const {
	title,
	description,
	noindex = false,
	seoTitle,
	ogImage = '/og.png',
	schema,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	navBordered = true,
} = Astro.props;

import '../../shared/styles/field-and-ledger.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { GA_MAIN } from '../../shared/analytics';

// Requires `site` to be set in astro.config.mjs — without it Astro.site is
// undefined and this throws at build time rather than silently emitting a
// broken canonical.
//
// build.format is 'file' (astro.config.mjs), so Astro.url.pathname here is
// e.g. '/about.html' — but the URL Netlify actually serves at, and the one
// every internal link and the sitemap use, is '/about'. Strip .html.
const cleanPath = Astro.url.pathname
	.replace(/index\.html$/, '')
	.replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, '');

const headTitle = seoTitle ?? title;
---
<!doctype html>
<html lang="en">
	<head>
		<SeoHead
			title={headTitle}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogType={ogType}
			siteName="Jon Martin"
			schema={schema}
			noindex={noindex}
			analyticsId={GA_MAIN}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			rss={{ title: 'Jon Martin — Writing', href: new URL('/rss.xml', Astro.site).href }}
		/>
	</head>
	<body>
		<Nav bordered={navBordered} />
		<slot />
		<Footer />
	</body>
</html>
