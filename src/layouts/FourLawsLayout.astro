---
import Nav from '../components/Nav.astro';
import SectionFooter from '../components/SectionFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import { GA_FOURLAWS } from '../../shared/analytics';
import { breadcrumbSchema } from '../lib/schema';
import { fourLawsGroups } from '../lib/four-laws-links';
import '../../shared/styles/field-and-ledger.css';
import '../../shared/styles/section-reading.css';

interface Props {
	title: string;
	description: string;
	/** Utility pages that shouldn't appear in search. */
	noindex?: boolean;
	/** Full <title>/og:title; bypasses the "| Four Laws…" suffix. */
	seoTitle?: string;
	/** Root-relative social card. Defaults to /four-laws-og.png. */
	ogImage?: string;
	ogType?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
	title,
	description,
	noindex = false,
	seoTitle,
	ogImage = '/four-laws-og.png',
	ogType = 'article',
	schema,
} = Astro.props;

const cleanPath = Astro.url.pathname
	.replace(/index\.html$/, '')
	.replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, '');

const siteName = 'Four Laws of Complex System Design';
const fullTitle =
	seoTitle ?? (title.startsWith(siteName) ? title : `${title} | ${siteName}`);

const isHome = cleanPath === '' || cleanPath === '/';
const breadcrumb = isHome ? undefined : breadcrumbSchema(title, canonical, Astro.site!.href);
const schemaList = [
	breadcrumb,
	...(Array.isArray(schema) ? schema : schema ? [schema] : []),
].filter((s): s is Record<string, unknown> => Boolean(s));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<SeoHead
			title={fullTitle}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogType={ogType}
			siteName={siteName}
			schema={schemaList}
			noindex={noindex}
			analyticsId={GA_FOURLAWS}
		/>
	</head>
	<body>
		<Nav section="four-laws" />
		<main id="main">
			<slot />
		</main>
		<SectionFooter
			groups={fourLawsGroups}
			label="Four Laws sections"
			colophon={`Four Laws of Complex System Design &copy; ${year} Jon Martin.`}
		>
			Written by <a href="/about">Jon Martin</a>.
		</SectionFooter>
	</body>
</html>

<style is:global>
	/* Figures: hairline frame + Field & Ledger caption (Four Laws only). */
	main figure {
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--hairline);
	}
	main figure img {
		display: block;
		width: 100%;
		height: auto;
	}
	main figcaption {
		margin-top: 0.75rem;
		font-family: Calibri, Carlito, Lato, sans-serif;
		font-style: italic;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
